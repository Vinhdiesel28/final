-0.024761835867522064,-0.06201171355006701,-0.04294665430784164,0.01451860017178045,-0.04053990733619491,0.026408449446488413,-0.0716413757799411,0.01923506744952539,-0.10316075686724953,-0.002072954171261298,0.015935625607546088,0.002195291252918305,-0.01437468717767908,0.00541284186667439,0.04303869105834832,0.0649157825033334,-0.006426051164872874,-0.015330745602890713,-0.01504995437919592,0.018042700975094833,-0.02154645753879914,-0.011744313410753358,0.006181487905509218,0.04133064307067405,0.015977148876259603,0.07451316232379522,-0.008439241578676145,-0.044987591582410814,0.016800148294838474,-0.09000893245271402,0.048682020442348206,-0.01182021754899434,-0.08265188059572176,-0.04687009410988151,-0.025906254615100387,0.032857088234525635,0.047071966399740865,-0.028882499124066704,0.00023716244133343135,-0.037161698933345214,0.024785114654379936,-0.06071767762596742]},{`id`:'chunk_3762f7cb8e8dc3f21ad9cc6c',`document_id`:'summary_dia_classification_001_9498356feb2d',`title`:'Diabetes in America, Chương 1 - Phân loại đái tháo đường - Trang 1-2–1-3',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Đái tháo đường là nhóm rối loạn chuyển hóa có đặc điểm chung là tăng glucose huyết. Tài liệu Diabetes in America phân loại thành bốn nhóm chính: đái tháo đường type 1, type 2, đái tháo đường thai kỳ và đái tháo đường thứ phát hoặc các thể đặc hiệu khác. Type 1 và type 2 chiếm phần lớn trường hợp. Các thể đặc hiệu khác có thể liên quan bất thường đơn gen của tế bào beta, bệnh tụy hoặc một số bệnh nội tiết. Không nên dựa riêng vào độ tuổi khởi phát hay việc có sử dụng insulin để xác định loại bệnh.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Phân loại đái tháo đường - Trang 1-2–1-3',`source_file`:null,`source_type`:'curated_summary',`source_version`:'9498356feb2d',`embedding`:[0.22604679038894784,0.19013842189430383,0.46818387199498546,0.3346922721150769,0.47091052930093935,-0.021560502536097162,0.010871928071014156,-0.08602176831529305,0.01498191497857516,0.12284901732505837,-0.05971773121745526,0.020417262011208182,0.24290355087866952,-0.0007393996590054652,-0.006923485058204525,-0.042523647239255134,-0.029781141648486498,0.010389423329274573,-0.03848679977157925,0.03142574448159635,-0.00339004008741423,-0.03446083571944021,0.09488263911756546,-0.05965466133279885,-0.01906348623143149,-0.08190966690542724,-0.08377376979133216,0.033190469847654135,0.06599412301418135,0.0321203203108701,0.004740662315648009,0.027069176569327155,0.035305347468397606,0.0011286213878352479,-0.02398625559450109,0.01253819526897539,0.03334837096179973,-0.021914358782346627,-0.022493235266752263,-0.07057924884236892,-0.050049766361517346,-0.02910791847685415,-0.0033727970082350223,-0.06806664142739724,0.04308317715191503,-0.07700949487267016,0.06927865739269229,-0.1040733482052269,0.03057035645743566,0.042933249091471754,0.0020826474055111424,0.06681718201989535,0.046996276984219605,0.06138266267887587,0.1312209117985504,0.000650309215930955,0.02255348693873266,0.08861998646817303,-0.10310879959627771,-0.09777965955409518,0.026153484356973716,-0.016723663610124583,-0.1737413182668473,-0.009957376284245256,-0.03286223114992407,-0.08229533453075237,0.032850929846400846,-0.06785960641257942,-0.04407378662884427,-0.07403215870113125,-0.01361353539044588,0.07137213814778968,-0.034033991857256335,-0.01731815183576645,-0.022776980647603102,0.04554744198659638,0.08037806251158779,-0.05571727936259421,0.03062880074339216,-0.04986672365708805,-0.05624603138907433,0.03658374601172071,-0.03973904356450416,-0.006548202709540569,0.0020922043670375135,0.023636112254698468,-0.03361730087845918,-0.03809536610697353,-0.04377061933757754,0.024363276904461738,-0.024443304095976358,-0.02007644076294429,0.04935698260593779,0.038204067551868136,-0.0008802421531342768,-0.024029383461487485,-0.017937940888202913,0.023770170345416418,-0.06905322978303814,-0.0025513543896255033,-0.012617502127077388,0.03327085125020154,0.010001631838029388,-0.040451177484941446,0.027096355977352746,-0.017998420719885055,-0.017173471575729002,-0.015170679333108127,-0.007431989533314408,-0.013988246181352228,0.05181663133507772,0.008944028756811153,0.05700020146859393,0.04380099016771118,-0.0054852748861237794,-0.03954593781357248,-0.055008960907551745,0.037295396212429215,0.004849329657049047,0.05492381334167278,0.04076902927252489,-0.02076152829124255,0.06873459872115167,0.013009874600028061,0.01245306816704624,-0.0375347174984548,0.07607797551782194,-0.0023488278339498588]},{`id`:'chunk_de62a322ecafb41df9f030ce',`document_id`:'summary_dia_type1_mechanism_001_22a2408a5781',`title`:'Diabetes in America, Chương 1 - Cơ chế type 1 và tự miễn - Trang 1-3',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Ở phần lớn trường hợp đái tháo đường type 1, hệ miễn dịch tấn công tế bào beta của đảo tụy, làm suy giảm nghiêm trọng khả năng tiết insulin. Các tự kháng thể liên quan tới GAD, insulin, IA-2 và ZnT8 có thể hỗ trợ nhận diện căn nguyên tự miễn và phân biệt với type 2 trong bối cảnh phù hợp. Thiếu insulin làm glucose huyết tăng và có thể xuất hiện nhiễm toan ceton. Tuy nhiên, không phải mọi người mắc type 1 đều có cùng biểu hiện hoặc cùng tốc độ mất chức năng tế bào beta; chỉ dựa vào tuổi hay cân nặng là không đủ để phân loại.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Cơ chế type 1 và tự miễn - Trang 1-3',`source_file`:null,`source_type`:'curated_summary',`source_version`:'22a2408a5781',`embedding`:[0.18324643898789947,0.126941161209497,0.41981955499868606,0.4263190489769646,0.5065817934234292,-0.014219925594445718,-0.026502621249005983,-0.15035300413171918,0.07800113136480276,0.13353462931015112,-0.03060131915740603,0.03164013030774869,0.2545289302842096,0.07979627380266115,0.04022117629786493,-0.06762791691548851,-0.028630215377029474,0.035380669430223104,-0.025314016756488072,0.06453366946213854,0.05134168169144199,-0.02529102730216654,0.09991437162421496,-0.09767535535059431,0.066427067407808,-0.0422920499963705,-0.06055654847246239,0.05219654179638899,0.07315545313355971,0.09287560419357632,-0.006167509824997849,0.03364570486892433,-0.0016003644492844518,0.009311190882365908,-0.005460838214368357,0.0005189274821969202,0.036558125170658345,0.0019074618310759668,-0.019035649859059856,-0.031837033045313747,-0.04910199121213457,-0.027135918534555898,-0.01563617939238882,-0.03854295488509548,0.011775273328156997,-0.08081608930958689,0.06387298364430156,-0.06844121220738268,-0.004268620418892376,0.013860077936308283,-0.005842536645229659,0.08126222198785084,0.01876231982741668,0.03687569855474153,0.07222045749706786,0.03634292023407167,0.029694925819630732,0.049634658964953414,-0.06382555211197231,-0.06729275746498614,0.03548045861107384,0.03452012713719927,-0.11041492524414902,0.0324664546196602,-0.022870972866155533,-0.011481129457904,0.0034693075345421823,-0.003510423353370292,-0.016288913057195105,-0.03997557776225746,0.012604555965985642,0.10338805229873695,-0.005654559873836677,-0.013533764292853865,0.028220264282830896,0.02509414048003255,0.035920702170919375,0.0010315029721471953,0.02243533628549085,-0.05122263461154811,-0.05286042267840671,0.0032218930678890962,-0.0008906124999917165,-0.03846093026661295,-0.02486743913917145,0.010932452277507065,-0.03907697800019738,-0.0143072147150007,-0.05928245364622704,-0.02274487239531065,-0.016174109906607614,-0.011629507875748533,0.07612667939856925,0.009602205448647491,-0.03170273911996841,-0.023918999599935053,-0.02426634965188721,0.02842426791439787,-0.04594870447622146,0.019794011375143906,-0.026768292973822105,0.015054822416153439,-0.00022474824684018074,-0.04018630861372493,0.035020571399393984,0.013020601682058883,-0.009381753575219512,-0.011678203097377042,0.009217534774618502,0.05732726538767646,0.042640075922333695,-0.013175286141899056,0.026890115820016647,0.003222504913215178,-0.05665552354486155,-0.047435544540493466,-0.07041208606955515,0.08680035954420488,0.004017952565019509,0.05211423291804285,-0.017635173848186237,0.00560094307798643,0.07366178122889352,0.01686911030520414,0.016183698553145186,-0.045908155681873127,0.042287615392733256,0.05007078082892655]},{`id`:'chunk_67bb91cc59be2e2f8cbf75a9',`document_id`:'summary_dia_type2_mechanism_001_d567ab32e4c2',`title`:'Diabetes in America, Chương 1 - Kháng insulin và thiếu insulin tương đối - Trang 1-3–1-4',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Đái tháo đường type 2 hình thành khi kháng insulin kết hợp với khả năng tiết insulin không đáp ứng đủ nhu cầu của cơ thể, còn gọi là thiếu insulin tương đối. Kháng insulin thường đi kèm béo phì và cũng có liên quan với lối sống ít vận động cùng tuổi tăng. Khi chức năng tế bào beta giảm dần, khả năng bù trừ cho tình trạng kháng insulin trở nên kém hơn. Dù vậy, type 2 không chỉ gặp ở người thừa cân hay lớn tuổi; người gầy và trẻ em cũng có thể mắc. Các đặc điểm lâm sàng riêng lẻ không đủ để chẩn đoán phân loại.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Kháng insulin và thiếu insulin tương đối - Trang 1-3–1-4',`source_file`:null,`source_type`:'curated_summary',`source_version`:'d567ab32e4c2',`embedding`:[0.14468964230620615,0.11374596279670353,0.3508322266473152,0.39833677019541786,0.47494074881682025,0.007954861859550315,-0.028201279010232748,-0.15801870586217534,0.0994545212031387,0.14514754120851384,-0.014936373033489218,0.009356456835351785,0.3068915050322485,0.1392763794101077,0.0503508728956539,-0.08905555021582603,-0.047492154846712896,0.06289451903422023,-0.04313516935148315,0.11262305393802616,0.09224595858321637,-0.05542537019478285,0.11042799657113486,-0.0964792401650887,0.08825879495649887,-0.017609013478403157,-0.051809721119084357,0.06456907331625548,0.07021296783710479,0.12931