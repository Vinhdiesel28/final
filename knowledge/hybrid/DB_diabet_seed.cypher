6548628421763449,-0.0414321405370735,-0.07175861852300307,-0.00043030284189739146,0.0634600878462337,0.04464275197753653,0.0007915584433684535,0.013731586668117227,0.069577002421609,-0.0663885613464206,-0.0059539265656042666,0.0155506548922158,-0.002992214934711834,0.04591862609242402,0.009767594574654054,0.0036478579102437684,-0.03819268847959889,-0.06476286943604499,0.0023857429126447308,0.055177286280892454,-0.07105380057906303]},{`id`:'chunk_f114ff5009f3bf7f9f7dcf29',`document_id`:'summary_ndep_risk_conditions_001_ec4560a9d0d6',`title`:'Guiding Principles - Các yếu tố nguy cơ bổ sung của type 2 - Trang 9',`url`:'https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf',`text`:'Bảng yếu tố nguy cơ trong Guiding Principles liệt kê thêm một số đặc điểm liên quan nguy cơ đái tháo đường type 2 ngoài thừa cân, tuổi và tiền sử gia đình. Những đặc điểm này gồm tăng huyết áp, ít hoạt động thể lực, tiền sử đái tháo đường thai kỳ, hội chứng buồng trứng đa nang và tình trạng liên quan kháng insulin. Bảng cũng đề cập HDL cholesterol thấp hoặc triglyceride lúc đói cao theo ngưỡng nêu trong tài liệu. Đây là những yếu tố hỗ trợ quyết định sàng lọc, không phải bằng chứng rằng từng yếu tố riêng lẻ trực tiếp gây bệnh hay chắc chắn dẫn đến type 2.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Guiding Principles - Các yếu tố nguy cơ bổ sung của type 2 - Trang 9',`source_file`:null,`source_type`:'curated_summary',`source_version`:'ec4560a9d0d6',`embedding`:[0.2093092932949979,0.22028633152513674,0.3582027334038688,0.24365758749605926,0.6700961149996418,-0.11763958998984093,0.004639355256576412,-0.08263762802195682,0.03026064934456977,0.04793673900049244,-0.017806878752363642,-0.03654625965846376,0.07345276187356793,0.09936777473582202,0.048887785334730954,-0.04464328950044158,-0.019911956143550222,0.030527733356459863,-0.0016130345841809603,0.05587377652906066,0.017441152617538765,-0.11229964661865831,0.021523756075721833,-0.01874558259425503,0.015907487738391828,-0.027918281946823977,-0.006015251283718615,0.022264078950966867,-0.0006110315474718038,0.03905555604439699,0.0051360014020579246,-0.012872517593685897,0.0032580635848870826,-0.020990636171430745,0.007342867226479132,-0.00910911422709831,-0.030982259541256444,-0.010150488308566878,0.047909221810914365,-0.043603244369795166,-0.08351417095494174,0.006041166129428409,-0.02327366905359623,0.028686207569291276,0.0058205425718592975,0.045681967243912436,0.02929102880633254,-0.07409577388666387,-0.029871638294388273,-0.010966493353048359,0.04100893140280789,0.109964104967925,0.01879046934160517,0.09053701069156928,0.012428061434674063,0.0911661556633541,0.04297131063167684,0.08176695964086177,-0.01768576317135246,-0.035599102788916225,-0.048927454398170575,0.0875301443320084,-0.03422385853622323,-0.04861787671657304,-0.03872631996992923,0.0009646638283407048,0.08750601168125051,0.0033675864029487413,0.017983482006630174,0.030504864032378495,0.008451467718017495,0.007363714909086111,0.062623043736317,0.008547524119516843,0.0792919848920038,0.07401626059482991,-0.054551573142922645,-0.10425952571924922,0.03948771210267748,0.005089380742868706,-0.06435466723256608,0.037679383998488386,0.0155174698997506,0.07288463282496821,-0.08550963985657865,0.005265061903375966,0.031741771279826206,-0.06620349820986655,-0.04732228975929034,-0.05231542455978312,-0.03384124802326344,-0.02163804250376436,0.006644263843289653,0.03434156298135023,-0.005382487958118764,0.021918727142805686,-0.0700431787703418,-0.020715885743994012,0.00010681956537256803,0.06867614835588584,-0.07250444322037879,-0.023389577521695865,-0.017355389637955958,-0.023400206727593804,-0.013812865293952861,0.0045756885621846596,0.06521613792158708,-0.018127172337172637,0.007826369599635,-0.013162593439992641,0.025809114812039635,0.10980762328135703,0.02189432424148623,0.014940514197882494,0.005531428523746411,0.07196956465021084,-0.04033538672730569,0.02253791508245939,0.026811491497303046,0.02097892269641519,-0.020026112375925557,-0.0035544299008491596,-0.03860812612183434,-0.014679084961345411,-0.040120775728639244,-0.014117926630796827,0.045553720132423675,-0.050120562543804086]},{`id`:'chunk_94726e2082075f1b55c272d4',`document_id`:'summary_ndep_a1c_ranges_001_04da6cfea94e',`title`:'Guiding Principles - Ngưỡng A1C theo tiêu chí sàng lọc 2018 - Trang 11',`url`:'https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf',`text`:'Theo Bảng 2 của Guiding Principles năm 2018, A1C từ 5,7% đến 6,4% là một tiêu chí xét nghiệm nhận diện tiền đái tháo đường; A1C từ 6,5% trở lên là một tiêu chí xét nghiệm của đái tháo đường. Những khoảng này là tiêu chí xét nghiệm được trình bày trong Bảng 2 của tài liệu năm 2018. Khi dùng A1C để chẩn đoán, phải chú ý tính hợp lệ của xét nghiệm và quy tắc xác nhận kết quả nếu chưa có triệu chứng điển hình. Chỉ một con số A1C không thể thay thế việc xem xét tình trạng người bệnh và các yếu tố làm sai lệch phép đo.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Guiding Principles - Ngưỡng A1C theo tiêu chí sàng lọc 2018 - Trang 11',`source_file`:null,`source_type`:'curated_summary',`source_version`:'04da6cfea94e',`embedding`:[0.16364993330040487,0.18435800889361034,0.3758086211417265,0.15732557527589594,0.6320302154929383,-0.12995805483787035,-0.003641819123526054,0.026500166611116073,-0.03225802672791178,-0.036463577926168424,-0.033229480100439614,-0.1143562651543973,-0.12264491017727924,0.11923304952869021,-0.05475233416857901,-0.024408732494188366,-0.06871385952374987,-0.05878183753008557,0.02373951584678995,-0.007650821489213731,0.006088359442698975,-0.10316390473559792,-0.034514824630822644,0.005658612294954743,0.05683195431598694,-0.011985589411521547,0.01915041966312876,-0.014345493164080778,0.0268064431298628,-0.0005626884437682061,0.01478598167545606,-0.036481170898564015,0.014977230765161796,0.007858586197906714,-0.007205911710755915,-0.038533357757175105,-0.038826775753678336,0.05919545415836105,0.01300182100001018,-0.010843620209131434,-0.08664896499454205,-0.0074138650089677245,-0.015027082654814804,0.012562523213782532,0.06871101366591881,-0.00823749211433518,0.015077494209849916,-0.0605832517964274,-0.010866399276327446,-0.05503143433924643,0.016034129758727454,0.065873871657414,0.05890513125854222,0.018481497157219445,0.012191878393006995,0.06317776778180259,0.10988269855128639,0.05090712845289585,-0.03824918293471464,-0.07184956229126217,-0.0728583411679844,0.11373739483497065,-0.012672896001882693,-0.1183600686248203,-0.039835068917565414,-0.012034042761909053,0.05971149746147087,-0.03347097715485524,-0.05819706182725824,0.10565046216224785,0.05394673003136032,-0.04393433276121567,0.06578839244168522,0.013555658008239288,0.02419660641997519,-0.029364301725207,-0.10349143342114347,-0.1761677129098552,0.07634379076220218,0.08240695029128862,-0.02655533703320131,0.0628580994361969,-0.046146609859275114,0.022375515202501313,-0.0016909414278586915,0.03275554191089299,0.033352557258040615,-0.024819015006285625,0.028009689773800778,-0.015866078880126516,-0.09355510220495931,-0.016890420903072634,-0.0072229544871037716,0.013662732190691265,0.004532104181539589,0.04714301993932091,-0.04047627249396166,-0.08123439226778205,0.10648056053464704,0.01283760329855057,-0.004622396100037598,-0.035419468157206174,0.04322504157897086,-0.013595494495572577,-0.05552390598752242,0.029701684253051714,0.01985282433720723,0.024782965099133338,0.029583010413975926,-0.03942671860469001,-0.09038592345711433,0.036908250423993365,-0.08180339289593329,0.003171409351413773,0.010314994427732932,0.05023354339810948,0.04953522736096402,-0.06810152723737461,0.015510211344641403,-0.02609587894379349,0.03458120072702606,0.05646483122774606,0.008588061216016657,-0.06507036106937968,0.006425122174247279,0.10404853485302062,-0.03147279684498001,0.005403341250689417]},{`id`:'chunk_5cd80de7f068dbb3ca97bc80',`document_id`:'summary_ndep_glucose_ranges_001_7cbbcd9beac0',`title`:'Guiding Principles - Ngưỡng glucose huyết tương và OGTT - Trang 11',`url`:'https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf',`text`:'Trong Bảng 2 của Guiding Principles năm 2018, glucose huyết tương lúc đói từ 100 đến 125 mg/dL là khoảng rối loạn glucose huyết lúc đói, thuộc tiêu chí tiền đái tháo đường; từ 126 mg/dL trở lên đạt ngưỡng xét nghiệm đái tháo đường. Với nghiệm pháp dung nạp 75 g glucose đường uống, glucose huyết tương sau hai giờ từ 140 đến 199 mg/dL thuộc khoảng giảm dung nạp glucose, còn từ 200 mg/dL trở lên đạt ngưỡng đái tháo đường. Các mốc này phải gắn với thời điểm lấy máu, tải lượng glucose và điều kiện xác nhận, không được áp dụng tùy tiện cho đo glucose bất kỳ.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Guiding Principles - Ngưỡng glucose huyết tương và OGTT - Trang 11',`source_file`:null,`source_type`:'curated_summary',`source_version`:'7cbbcd9beac0',`embedding`:[0.18007059607501744,0.05496828896605203,0.44777194922197644,0.14690356028247675,0.4463863663837049,-0.1423040851765758,-0.1279754804781131,0.1953638414907202,0.009691350859839593,0.012099104324574936,0.21498372731057003,0.1705002562729259,-0.1379771274564823,-0.037552972513162974,0.005816025000245485,0.0694877703630825,0.0405419489059025,0.018185231342700316,0.07467409449531615,0.022217329032414468,0.006565393138877669,-0.03514885984295732,-0.11711447077906252,-0.07543196360751973,0.020374117448455686,-0.09945155212618761,-0.0362753304138567,-0.009933252405965216,-0.0041426337183376296,0.06925464608586554,-0.010174457317051584,-0.08381925134546825,-0.01865318516205427,-0.03550530374807764,0.00044262336286591457,0.018646879033597085,0.044704974848270705,0.05072664240166592,0.012423587925805505,0.024614304616293044,0.0080489104002779,-0.043854733613495074,0.03660638302953217,0.03721246574881955,0.160807572159378,0.0034084338347919432,-0.032002203940128635,-0.012313201011826593,0.09142223301000277,8.910334358313039e-05,0.07142557814213613,0.021518218232490637,0.010229520184364337,-0.11574723264652421,0.02243696088257282,-0.005509529247169489,0.07756555825012869,0.07135615569478901,-0.10596011608643051,-0.11332902705226884,0.012768436988731771,0.11451246068841545,0.011731666004272558,-0.015472207128168282,0.044847973152331404,-0.002654575989130085,-0.0043412374462037055,0.001100543270114838,-0.14525633513401928,0.10135534279227874,0.08282984862181135,-0.10110007345291526,-0.010497039452652377,0.0317656478491869,-0.09035715051181006,-0.15114755516958306,-0.048906538552177366,-0.13571207409804303,-0.0014449773817320913,-0.002399323580120706,-0.030445213471318806,0.0854861894297107,-0.01670106990725033,0.033345690848908406,0.014718997644832746,0.06556673802807612,-0.02760759403434859,-0.009544993801077989,-0.002135517808899389,0.09682582570069329,-0.044153271291800474,0.06213678134359575,0.055469617176016624,0.011883721434977927,0.039229212958354055,0.03718186482758281,0.06389447632892858,0.008467142974994518,0.07395970655425041,-0.034909420273047435,0.06429702142166696,-0.002008117723565435,0.014385907739260163,-0.010022750222921257,-0.06175852668707584,0.04005139141835132,-0.0008996775222636675,0.035609049546225645,0.02173063786392998,0.049297924773096115,-0.04504021792021156,0.009545569620030319,-0.05157827350185099,0.014920954689812145,-0.062171424693592894,-0.01267172870631661,0.056088026640820965,-0.025097413548362573,0.00847021461813664,-0.019951043135666067,-0.00766880140962991,-0.0782847738784673,-0.004532354657793439,0.09424986644439683,0.05258208714842574,0.006442367330005911,-0.03321476275583539,-0.04930996496725862]},{`id`:'chunk_791af1576e46d65b8fca3637',`document_id`:'summary_ndep_confirmation_001_53af528ace9c',`title`:'Guiding Principles - Xét nghiệm xác nhận kết quả bất thường - Trang 10–11',`url`:'https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf',`text`:'Khi kết quả xét nghiệm sàng lọc vượt ngưỡng chẩn đoán đái tháo đường, Guiding Principles khuyến nghị xét nghiệm xác nhận, trừ trường hợp có triệu chứng rõ phù hợp. Có thể lặp lại cùng xét nghiệm vào ngày khác; nếu dùng hai loại xét nghiệm khác nhau mà đều vượt ngưỡng, kết quả có thể hỗ trợ xác nhận. Nếu hai phép thử bất đồng, nên lặp lại phép thử đã vượt ngưỡng chẩn đoán. Mục tiêu của việc xác nhận là giảm khả năng kết luận dương tính giả. Người có kết quả sát ngưỡng hoặc chưa nhất quán cần được theo dõi, đánh giá theo hoàn cảnh lâm sàng, thay vì tự chẩn đoán.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Guiding Principles - Xét nghiệm xác nhận kết quả bất thường - Trang 10–11',`source_file`:null,`source_type`:'curated_summary',`source_version`:'53af528ace9c',`embedding`:[0.12910564756156098,0.18307865724532643,0.3396499460099824,0.18861610683929614,0.6902655353883353,-0.12314092046053768,0.043397832262582633,0.014649195217204815,-0.043331378313800496,-0.032098453272023326,-0.03132876000958362,-0.0689233968111979,-0.06570883899762586,0.08127629495453548,-0.016705428801410283,-0.022477018156894013,-0.044696795311171864,-0.020354717223305462,0.011956815763812304,0.02095325115462266,-0.014343570876814267,-0.08441418296303636,-0.04254344872765705,-0.01587261050409568,0.03809424095679487,0.0022688813020189536,0.05175930820775923,-0.010068379861450323,-0.012116610866662708,0.010331776620915544,-0.014303439260913424,0.004916722893290692,0.01719234681651533,0.03315900044674112,-0.005490726188835044,-0.00665272608382473,-0.041183471042704575,0.061231990597140885,0.0144000777731421,0.018567676135863565,-0.06561118766452553,-0.034807061107369745,0.029829123989886182,0.021611602755682136,0.06826724860132426,0.0176227032433002,-0.013352857945587552,-0.07645617772132544,-0.007085198571085952,-0.03678496423028246,0.016521998697396078,0.044692184717594674,0.045902578608242615,0.006009354543860487,-0.001471734606155816,0.04736167702388152,0.08058711933941475,0.058297975525368174,-0.07136607669247354,-0.056764269501885393,-0.06896736909880523,0.12515885623341488,-0.03329255381503658,-0.10160671487961746,-0.03030065677137432,-0.0285640997331861,0.056813151064543974,-0.015814006045986328,-0.09184501595223764,0.08013505845257096,0.047170025768138765,-0.0008667768766009526,0.03294980404294406,-0.0013439138519593249,-0.031247905614427127,-0.012511383512216707,-0.05092781105052932,-0.17227000165209572,0.11608238574691612,0.06699376539775671,-0.013594166812647239,0.07114278153015936,-0.013840079511208542,0.04624540603902221,-0.012132537977417295,0.04323789919940971,0.043453939101962644,-0.022332268476964644,0.017025991135543418,0.010379642392325012,-0.10463188586185675,-0.02355270550332357,-0.02733343148103786,-0.015368574748382663,-0.01122429778508723,0.00923562376560828,-0.011409275468191763,-0.07986319585054505,0.06186066937572652,-0.016585453377987378,-0.005233127020318982,-0.04878926252027986,0.059765854701125755,0.003528027765919239,-0.09089248543614377,0.045011514703146974,-0.009540739028043938,0.038009547878652815,0.02334730898213089,-0.026200013132251235,-0.09847214311859102,-0.005509538209489295,-0.10784716933657928,-0.011349504815240817,-0.029053681086157544,0.04129816095366761,0.08695683612585575,-0.05265359821239688,-0.006173256413516582,-0.02991793267357478,0.024763605278474456,0.05184518685123103,-0.006597208296115398,-0.05761634597995365,-0.02285976952393815,0.0867821890948882,-0.06584995177108255,-0.019890019271911353]},{`id`:'chunk_1029277b1ae9a9ee4cc723c6',`document_id`:'summary_ndep_a1c_method_001_d7c35d0cf7dc',`title`:'Guiding Principles - Điều kiện và giới hạn khi dùng A1C - Trang 10',`url`:'https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf',`text`:'A1C có thuận tiện là không yêu cầu nhịn ăn trước lấy máu, nhưng Guiding Principles lưu ý cần thực hiện bằng phương pháp phòng xét nghiệm được NGSP chứng nhận nếu sử dụng cho mục đích chẩn đoán. Bản hướng dẫn này không khuyến khích dùng phép đo A1C tại điểm chăm sóc hoặc đo glucose mao mạch đầu ngón tay để chẩn đoán. Một số dạng thiếu máu, suy thận, bệnh gan và biến thể hemoglobin có thể làm A1C không đáng tin cậy. Ngoài ra, A1C không được dùng để chẩn đoán đái tháo đường thai kỳ theo nội dung tài liệu. Kết quả cần được diễn giải đúng bối cảnh xét nghiệm.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Guiding Principles - Điều kiện và giới hạn khi dùng A1C - Trang 10',`source_file`:null,`source_type`:'curated_summary',`source_version`:'d7c35d0cf7dc',`embedding`:[0.19237820837948869,0.13652678540371224,0.4375616943205444,0.15915464219141126,0.5879288150289356,-0.09063329940851937,-0.07574693999527754,0.028505773863362806,0.02617899790189034,-0.05616533809539822,-0.14282946242097733,-0.11941987728242338,-0.21819220000676062,0.10775524055236067,-0.08113901341165629,-0.027714315861700794,-0.12515029631354344,-0.07417245098479323,0.021784519051969098,-0.029795997513717642,0.007738670938657798,-0.06738731763433979,0.021244604358602787,0.007422700715198741,0.08959782176696253,0.012217184652666933,-0.036147896992927746,-0.02750907038740265,0.07383996638896209,0.025746825840313556,-0.010296244967437026,-0.052678665428612416,-0.02664767005032499,-0.011780974442702324,0.05762349367439167,-0.06232293332092209,-0.0018151839182705461,0.1134647997292116,-0.024359074693152218,-0.0037303041195365107,-0.09842656163165885,-0.0046537918589362555,7.322936358567524e-05,0.003696748496032084,0.07918096972857167,-0.039383970666983216,-0.012945014500533258,-0.058011214918486535,0.0655107483263611,-0.04120246406570147,0.010923949712143572,0.0015918539813994997,0.0712962249328469,-0.0047765639328686445,0.042799610163551695,0.027695899150141985,0.09105057163469839,0.007285518248286391,-0.10222335385739162,-0.07609278867415094,-0.02451391772572208,0.11651577796844616,0.019380895767355348,-0.08132270612651794,-0.03392338906006245,-0.04417985123109192,-0.03860470821184173,-0.017317026387866502,-0.061498920450737404,0.09291562491202149,0.047771958961826476,-0.016033466576047706,0.029507840383585837,0.0070689146265066555,0.028283760763768782,0.008636252415479245,-0.0682036120754142,-0.11821909326924623,0.027083839486405314,0.04200662822379948,-0.017282334498736635,0.045727317493675756,-0.025254405971091996,0.01771267989422801,0.0024338445041292493,0.010422075232058042,0.015854973870508708,0.012517307974329069,0.02343610695551203,-0.006476810041586881,-0.0630955694931801,-0.029227334399586063,0.00352157755045752,0.0024759611419204945,0.003947876848816091,0.018396383007085456,-0.05102745504716409,-0.037992774953265,0.05508180635539341,0.006947544077661483,0.018558019470812887,-0.020045410569111417,0.0534436032705152,-0.009926059108530394,-0.013888600580287729,0.008333879921396486,-0.04411811727197779,0.023092373806890328,0.05914995607767142,-0.01893449393317231,-0.10155934124833592,-0.05108617790474497,-0.07983533690188555,-0.049312536423492793,-0.0029234707741729485,-0.009254051267033997,0.027749760657061338,-0.036443440659558485,0.004574802036049474,-0.02150978268390945,-0.027253389223022447,0.08242721045470991,0.006004390471674039,-0.04596571142128076,0.014354688606093789,0.05149328405768686,-0.06575448782498365,0.04335644352626691]},{`id`:'chunk_518e8e2f08d57e280a2ab0a4',`document_id`:'summary_ndep_dpp_results_001_aeee365be9f5',`title`:'Guiding Principles - Can thiệp lối sống ở người tiền đái tháo đường - Trang 15',`url`:'https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf',`text`:'Guiding Principles tổng hợp kết quả các thử nghiệm phòng ngừa đái tháo đường ở người tiền đái tháo đường. Trong nghiên cứu DPP và một nghiên cứu tại Phần Lan, can thiệp về dinh dưỡng và hoạt động thể lực giúp giảm tỷ lệ xuất hiện type 2 khoảng 58% trong ba năm so với nhóm chứng. Chương trình DPP đặt mục tiêu giảm cân vừa phải và hoạt động thể lực cường độ trung bình, như đi bộ nhanh, ít nhất 150 phút mỗi tuần. Đây là kết quả trên quần thể nghiên cứu, không có nghĩa mọi cá nhân sẽ giảm đúng 58% nguy cơ hoặc chắc chắn phòng tránh được type 2.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Guiding Principles - Can thiệp lối sống ở người tiền đái tháo đường - Trang 15',`source_file`:null,`source_type`:'curated_summary',`source_version`:'aeee365be9f5',`embedding`:[0.1658615634801233,0.23702243881281437,0.3711533101261076,0.2261208803459629,0.6965912391869774,-0.13065497984588986,0.08267916956108645,-0.03218563434739517,-0.05180753700764895,-0.005185388590650377,-0.02596871286716847,-0.06289287847686545,-0.017687012605142105,0.0558006146297345,0.011070070415568126,-0.03310444249030457,0.008372739444646995,-0.0040893654731317675,-0.0032937027111338444,0.019510448215865915,-0.020667700881678103,-0.07144860732963518,-0.023446500256477265,0.023021903036933137,-0.009568921795847521,-0.010857657720614573,0.02750301386539232,0.005176422816131154,-0.05055874880255994,-0.001196786311532364,-0.018842291892447762,-0.017142381622418698,0.029129575445026566,-0.007033764119619232,-0.011232403410602837,0.004307273756099286,-0.04140155206471101,0.026916451409173228,0.05417390431589043,0.004466147113629709,-0.053704829575936724,0.001863962373632556,-0.02191690526776435,0.034318366834391316,-0.0021112340763968966,0.07395294915261405,-0.006484675387654497,-0.058759649417912896,-0.04401599853106025,-0.011396666467935787,0.06596415944892466,0.04957609304685771,0.010681393473636938,0.07828197918955412,0.013386694595289201,0.0802881367863364,0.06596569922309334,0.042091455793707634,0.0022290332561155294,-0.02115989397538935,-0.0837476812764862,0.05589723559748714,0.012278940034491969,-0.056570039160634605,-0.02558275278841915,-0.004828090820883295,0.05270351280121938,0.0006172525571127415,0.02474008592914779,0.04569469730595692,0.015669300866801475,-0.009236502674349617,0.04724025382930744,-0.0110388107081578,0.07424892429623467,0.05257269427205023,-0.07747796314684616,-0.04974094080698493,0.032793035092590836,0.03097238429173189,-0.005373548756514311,-0.021584766611128767,0.018788152656012518,0.10716468914487197,-0.08267571938018296,-0.014352528458125919,0.050572830474466014,-0.04514129444826219,-0.018159603214402832,-0.05159683901277442,0.027360629254638096,0.0215461128761919,-0.043979944685655255,0.03920579758329749,0.02263635990696235,0.030434474565549385,-0.05253583655111486,-0.03299437238165989,0.04156549913076754,0.0681528803840237,-0.06764373362403203,-0.021977682336141613,-0.03145870871787189,0.03612963916822996,0.031830658195859333,0.03429961721473584,0.0997945455056513,0.023929058513994066,0.039674504707527,-0.03158172410947159,0.05762651382102639,0.07345598982139245,0.00926318834067977,0.007099322469386051,0.053541444123897684,0.006601859071411705,0.01956984086685161,0.0584696936776114,-0.046048211202783136,0.03701831663080468,-0.06310003917137212,0.004474940101616577,-0.07800010363028914,0.03229134103669552,0.003538392422533439,-0.0008612027975380723,-0.08895192788730162,-0.022794397122301874]},{`id`:'chunk_6d565b6e7ceb27898d89817e',`document_id`:'summary_ndep_activity_effect_001_87704a3630a8',`title`:'Guiding Principles - Hoạt động thể lực và độ nhạy insulin - Trang 31',`url`:'https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf',`text`:'Guiding Principles mô tả hoạt động thể lực thường xuyên là thành phần quan trọng trong quản lý đái tháo đường. Vận động đều đặn giúp cải thiện độ nhạy insulin và kiểm soát glucose huyết, đồng thời có ảnh hưởng thuận lợi đến lipid máu, huyết áp và duy trì cân nặng. Tài liệu cũng liên hệ hoạt động thể lực với nguy cơ bệnh tim mạch thấp hơn. Lợi ích này không có nghĩa riêng việc vận động có thể xác định hay loại trừ chẩn đoán bệnh. Kế hoạch vận động cần xét đến khả năng, sức khỏe và tư vấn chuyên môn.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Guiding Principles - Hoạt động thể lực và độ nhạy insulin - Trang 31',`source_file`:null,`source_type`:'curated_summary',`source_version`:'87704a3630a8',`embedding`:[0.20544799339066425,0.17791808314380686,0.3740337544101986,0.24048412714989048,0.719747860492101,-0.10807957875902936,-0.0584489850752063,-0.024614484710081805,0.07767124881281774,0.024476550833268225,-0.01928442634420433,0.016229280857855754,0.040047126955204584,0.13125576156154922,0.05443815084383287,-0.034247965005789305,-0.053768447540707795,0.005882122682341977,0.024828681465787886,0.04846302966196069,0.0378149231964946,-0.09541962915729016,0.022725085730668847,-0.08872192491007606,0.09380948402268927,-0.007718191445145951,0.01678278129415637,0.0057342992668541455,0.026516260025059142,0.08574043756506944,-0.004668953138329162,0.025152354200619686,0.004957514918210108,0.04249518505753672,-0.006675817711134528,-0.00821058480492196,0.00028587536364272693,0.030582949778402868,0.0034392442349535026,0.015091424901748344,-0.032104768069385385,-0.04517704509404616,-0.015574838138412633,0.008069625501703996,0.045495261862807536,-0.005382076677499271,0.024275864332711537,-0.05978261408085697,-0.01676837034602398,-0.029832265779606938,0.013891258451846168,0.057915674082369306,0.03919848911020753,-0.025146261793316246,-0.008291931812218397,0.06598403548154505,0.06357565192928608,0.032354627906095626,-0.026155777254101203,-0.02190110259103386,-0.031997381830592454,0.10569939575783995,-0.025271650142502343,-0.0350054175167526,-0.03267325445714189,0.01584847277824999,0.027103863486459698,0.015762502066121457,-0.08493927496319287,0.03464166185006462,0.05815781472044004,0.011761892167920507,0.04075745094436529,0.016690047914404454,-0.0028971107011421366,0.012986148039744964,-0.04368971200407018,-0.06374955338084881,0.049323293967593045,0.0387370198403944,-0.024602094156096776,0.02894781560738662,0.029458877596417063,0.007345589783286523,-0.06631640785700219,0.024074570811809685,0.012210426923560365,-0.05284014084178641,-0.021845832268681555,-0.04401097821089636,-0.02657572320090673,-0.022035738572504952,0.044748230849581086,-0.020374650778231546,-0.0448991201974654,-0.010793827608310047,-0.04454413855816127,-0.021600963965097756,-0.02225554741630988,0.05253692406298089,-0.06293840904767634,-0.03647589093997716,-0.017426325148257517,0.0014050945449390487,3.504289554172198e-05,-0.012342147487384035,0.06252008142435145,-0.02953473530664659,0.009386973904339747,0.034622355180022546,0.041692090637987074,0.025076231375618842,-0.005044641357686825,-0.026844136064477168,-0.01806046845097012,0.010376424655966004,0.002731159234570301,0.02502337275401522,-0.006748059128097433,0.06215929787656581,-0.05141023294770065,-0.005787460644446495,-0.0434976620373111,-0.0008441413148162341,-0.019735072644769824,-0.025702655213870145,0.003507523980913512,-0.03745837752830617]},{`id`:'chunk_ad3d438e8dc12f12e267797d',`document_id`:'summary_cdc_75807_risk_001_33ed67320b16',`title`:'CDC - Who’s at Risk - Yếu tố nguy cơ theo infographic CDC - Trang 1',`url`:'https://stacks.cdc.gov/view/cdc/75807/cdc_75807_DS1.pdf',`text`:'Tờ thông tin của CDC liệt kê các yếu tố liên quan nguy cơ tiền đái tháo đường hoặc đái tháo đường type 2, gồm từ 45 tuổi, thừa cân, hoạt động thể lực dưới ba lần mỗi tuần, tiền sử gia đình mắc type 2, huyết áp cao và từng mắc đái tháo đường thai kỳ. Từng sinh con nặng từ 9 pound trở lên cũng được nêu là một yếu tố nguy cơ. CDC lưu ý một người có thể chưa có triệu chứng dù đã có tiền đái tháo đường hoặc type 2. Việc có yếu tố nguy cơ là lý do trao đổi với bác sĩ về xét nghiệm glucose huyết, không phải chẩn đoán.',`page`:null,`page_start`:null,`page_end`:null,`section`:'CDC - Who’s at Risk - Yếu tố nguy cơ theo infographic CDC - Trang 1',`source_file`:null,`source_type`:'curated_summary',`source_version`:'33ed67320b16',`embedding`:[0.1711981350916657,0.16426001648334113,0.4693871437638626,0.4091508144501