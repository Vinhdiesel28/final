41,0.03816983462180937,0.006554295973347357,-0.006225035677981907,-0.05698746652007055,0.00026495973465860126,-0.01858073300157991,-0.005856889863157295,0.015406028454548077,-0.01761162937314477,-0.04832418924720516,-0.07119318512808998,0.06546121357931906,0.10290214938067552,0.05862693673829592,0.005202644380679482,0.055757379503035415,0.08524409804525376,-0.09555926917441379,0.012888546479011453,-0.03118852593874378,0.010932822391583106,0.02413715211032349,0.018411457870143012,-0.0532347970017634,0.0177124861257359,-0.0694954063699127,-0.009808040912602034,0.06672330505679028,-0.10510943493540602]},{`id`:'chunk_6bb94ef2bd3297b94290f41a',`document_id`:'summary_cdc_135620_outcome_001_bb71f3eb95ce',`title`:'CDC - Prevent Type 2 Diabetes - Hiệu quả chương trình thay đổi lối sống - Trang 1',`url`:'https://stacks.cdc.gov/view/cdc/135620/cdc_135620_DS1.pdf',`text`:'Tờ thông tin CDC về phòng ngừa đái tháo đường type 2 trình bày kết quả nghiên cứu nền tảng của chương trình thay đổi lối sống. Việc giảm khoảng 5–7% cân nặng thông qua giảm năng lượng ăn vào và tăng hoạt động thể lực lên ít nhất 150 phút mỗi tuần gắn với mức giảm 58% tỷ lệ mới mắc type 2 trong nghiên cứu được trích dẫn. Infographic cũng nêu giảm 71% ở nhóm từ 60 tuổi và giảm 27% sau 15 năm theo dõi. Đây là các kết quả nghiên cứu theo nhóm, không phải mức giảm nguy cơ được bảo đảm cho một cá nhân cụ thể.',`page`:null,`page_start`:null,`page_end`:null,`section`:'CDC - Prevent Type 2 Diabetes - Hiệu quả chương trình thay đổi lối sống - Trang 1',`source_file`:null,`source_type`:'curated_summary',`source_version`:'bb71f3eb95ce',`embedding`:[0.13187080551496913,0.16239155200836375,0.44423104168872973,0.3878817727977168,0.5942700261055137,-0.06752867950217707,0.1568973054073209,-0.08553429976573995,-0.09006036977467098,0.0015289126861604597,-0.05182540611472815,-0.0724737693325496,0.045862522020753776,-0.010097063283050448,-0.04553672700370408,-0.05371833680907067,0.027947778037090774,-0.005229328212340652,-0.0041631