UNWIND [{`id`:'chunk_c145e1b0e8ed604048738abf',`document_id`:'summary_idf2025_test_disagreement_001_2d30cedc0fc5',`title`:'IDF 2025 - Không thống nhất giữa các xét nghiệm và yêu cầu xác nhận - Trang 22',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 nhấn mạnh HbA1c, glucose huyết tương lúc đói (FPG) và glucose sau hai giờ OGTT không phải lúc nào cũng xác định cùng một nhóm người mắc đái tháo đường hoặc tiền đái tháo đường. Mỗi xét nghiệm có đặc điểm về nhịn ăn, sự biến thiên sinh học, khả năng tiếp cận và các yếu tố gây nhiễu. Đối với người không có triệu chứng, tài liệu khuyến nghị cần hai kết quả bất thường, trong cùng lần đánh giá hoặc vào những lần khác nhau, để hỗ trợ chẩn đoán lâm sàng. Chưa có một xét nghiệm sinh hóa duy nhất được xem là chuẩn tuyệt đối để so sánh cả ba phương pháp.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Không thống nhất giữa các xét nghiệm và yêu cầu xác nhận - Trang 22',`source_file`:null,`source_type`:'curated_summary',`source_version`:'2d30cedc0fc5',`embedding`:[0.13546747053872307,0.08237233281083842,0.5055710531209882,0.4511538017448063,0.5932294014289186,-0.03232419749631413,0.0518921465754079,0.04350562706887556,-0.06219258300722331,-0.06479656458804631,-0.03021344759623638,-0.03153938190221127,-0.052281362388873424,-0.016950980468386553,-0.06371908069220054,0.020548469506843584,-0.011697939516743177,-0.07274661100930616,0.013977115933685022,-0.01076362605384339,-0.0270834315591848,0.02657939014491896,-0.03789571791081356,-0.016848382990766894,0.05263003459099811,-0.007529881892433994,0.06378767719672186,0.004494262767849297,0.018801548557602826,-0.01945909765664819,-0.008276558024739849,0.05434094537133003,-0.0018931229894098012,0.05143323935034194,-0.013170149185634163,0.024575337488813177,-0.0021521699210882415,0.020675810685584817,-0.039317965907858285,0.006797632305741764,-0.03230757050604702,-0.01206362444468237,0.0683698395274979,-0.008754994433081451,0.0412320281142494,-0.04041499004407361,-0.059394020366823404,0.010879214740839353,-0.011239596187692005,-0.04796225039982244,-0.044291575187407735,0.004380574963723839,0.00968087219314226,-0.03816271699920829,-0.008602632112523037,-0.02864616900211503,0.011532936919531658,0.02901175307771221,-0.049043167752918254,-0.041169490950177356,-0.004175809914271247,0.04144707916008386,0.006720982230987066,-0.02032845258219083,-0.002135124281781032,0.0061360519895214275,-0.030768863638785313,-0.013478726455204017,-0.0837461450311016,0.060477740082328015,0.03927388600241537,7.926793397044676e-05,-0.03214734173034407,-0.001515862770415008,-0.11075178462725314,-0.024625893364187253,0.003489428898827941,-0.043865889278089654,0.0598573107215953,0.030886582983432356,-0.015874494053614525,0.03517423204851896,0.005061957773815965,-0.04165439332187963,0.0305888678839914,0.047855848641736844,-0.010450584345729352,0.001840143236430229,0.010261987645932903,0.07250307649105016,-0.07127787721935558,-0.014327916653406565,-0.013346267689844163,-0.019252510566007474,-0.00122190750929432,-0.005815865762540596,0.013271589967563393,-0.015141338566968436,0.0027896348765850594,-0.025443648949003597,0.04076085367039945,-0.028084875008128205,0.029563326003896738,-0.004852885518811394,-0.08543134202711908,0.028786016653210265,-0.04444041066667394,0.024088112232467263,-0.010847162281155618,-0.027272996513739114,-0.05299739600450876,-0.026965659220590136,-0.045554323521695424,0.02804545549866628,-0.02640204974673663,0.047424905505345935,0.055323940970336806,-0.031162723806840778,-0.022141423590374257,-0.05029521854637475,0.030489651570749562,-0.010562804679894988,-0.00425386709533875,0.027388470717723892,-0.006141203158692681,0.0009918936339218325,-0.014533721742427173,-0.05137535519983055]},{`id`:'chunk_a5d25ab6e932772c60542850',`document_id`:'summary_idf2025_a1c_alternatives_001_4fdbbf3fd784',`title`:'IDF 2025 - Phương pháp theo dõi khi HbA1c không đáng tin cậy - Trang 38',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 phân biệt xét nghiệm HbA1c để theo dõi kiểm soát glucose lâu dài với những phép đo phản ánh giai đoạn ngắn hơn. HbA1c tổng hợp thông tin đường huyết của khoảng hai đến ba tháng nhưng có thể bị sai lệch khi người bệnh có bất thường hemoglobin, một số loại thiếu máu hoặc tình trạng làm thay đổi vòng đời hồng cầu. Khi khó đo hoặc diễn giải HbA1c chính xác, fructosamine và albumin glycat hóa có thể hỗ trợ theo dõi. Các chỉ dấu protein huyết thanh này phản ánh glucose trong khoảng hai đến bốn tuần trước đó. Chúng không nên được coi là tương đương hoàn toàn với HbA1c trong chẩn đoán bệnh.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Phương pháp theo dõi khi HbA1c không đáng tin cậy - Trang 38',`source_file`:null,`source_type`:'curated_summary',`source_version`:'4fdbbf3fd784',`embedding`:[0.18163520012031897,0.047078485180361083,0.47317449549406687,0.3930393793669632,0.45651944278583384,0.023419829642768068,-0.05553801286972462,0.08107104717259532,0.04471427962986938,-0.11881594032721321,-0.16191771729236476,-0.14788093270800873,-0.14313194278214694,0.0022513356678949908,-0.08509775681300699,0.016547153439979805,-0.0650071570834203,-0.09110365665162805,-0.05951065912560023,0.009372854122406854,-0.014700211915877648,0.05525908003280682,0.026439983583871625,0.05519326722508466,0.030257085886941728,0.06406239040788136,0.005130347321143252,-0.06029586002404115,0.06488694917396332,-0.014252181384018937,-0.03438565513008625,-0.012734318722512681,-0.01753683026150756,-0.013723914199860455,0.08169272418650507,-0.03798391229418872,0.028350030288231368,0.04747990744345658,-0.08199410573426137,0.011398668219031186,-0.09103014365222842,-0.021028843371008223,0.06575133083935039,-0.02144734543378244,0.0008608876605832095,-0.055007843705252635,-0.06420212312888801,0.015616103843498267,0.007983462920556522,-0.020176829061970113,-0.05330570094906928,-0.05338018747095353,0.008447243497789103,-0.008762074901906572,-0.009691140431864007,-0.03420153594123188,-0.0026654517346166354,-0.015889377947632226,-0.07284786006406294,-0.012557079041680286,0.02042532036342988,0.024120133672507253,0.052024217787605256,0.03119151395268042,-0.0013716288049011424,0.0012942128577909432,-0.11043442863561706,0.0204394911284336,-0.05540103534680989,-0.007453102421965365,0.034457308298559454,0.03795845592165304,-0.0694195078100349,0.013756947949811927,-0.0499233599422617,-0.08715117879339779,-0.0028895878344793427,-0.03557301593765178,0.036025510360888864,0.005451927678523638,0.012585114375982556,0.01598711064549971,0.0027972566938227494,-0.06139701312628156,0.055448257035313316,-0.015505309610349939,0.017019713763619323,0.023060625873711327,-0.013939269011381152,0.042813501885899496,-0.07644526864528815,-0.041157842078117235,-0.0038876608700624043,-0.07146177683923678,0.0019867728341161277,-0.045157157188437796,0.022124858004773734,-0.03233882836149484,0.07366646395699752,-0.042818873825121555,0.10119991229014734,-0.03664030617948709,0.06254479929830524,-0.03600338337907679,-0.01583425809371294,0.052253757070706126,-0.1118542326165276,0.002532805873015005,0.03190501823186838,0.053061658534372926,-0.13248763146390086,-0.14322045477357914,-0.09209401525358915,0.0004665899825239492,-0.03427672794780483,-0.06315098660729791,0.0832869756957692,-0.020618544244743114,-0.019783054169722453,-0.06222118928922118,0.012358688092232959,0.02094734332433445,0.004604068504960922,0.04802561825227278,0.046267150167940585,0.030829842038016177,-0.005610203985441844,0.07181995012487385]},{`id`:'chunk_b3cffc85402a9e55ada5435c',`document_id`:'summary_idf2025_a1c_target_001_fa34bafd0749',`title`:'IDF 2025 - Phân biệt mục tiêu theo dõi HbA1c và ngưỡng chẩn đoán - Trang 36, 39',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 mô tả HbA1c dưới 7,0% (dưới 53 mmol/mol) là mục tiêu kiểm soát glucose chung thường được cân nhắc ở nhiều người đã mắc đái tháo đường type 2, không phải tiêu chí dùng để chẩn đoán mắc bệnh. Mục tiêu theo dõi phải được cá thể hóa theo tuổi, bệnh đồng mắc, thời gian mắc bệnh, nguy cơ hạ glucose huyết, kỳ vọng sống, khả năng tiếp cận chăm sóc và mong muốn của người bệnh. Mức HbA1c rất thấp không hợp cho mọi trường hợp, vì lợi ích giảm biến chứng phải cân đối với nguy cơ hạ glucose huyết và gánh nặng can thiệp. Đây là nội dung dành cho đánh giá chuyên môn.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Phân biệt mục tiêu theo dõi HbA1c và ngưỡng chẩn đoán - Trang 36, 39',`source_file`:null,`source_type`:'curated_summary',`source_version`:'fa34bafd0749',`embedding`:[0.17718751290860565,0.049735284084145584,0.49218283024015425,0.4591170677636892,0.5314318078409417,-0.00554749623810352,-0.004651158125970578,0.11740088199029074,0.027528460722632982,-0.09605696896207105,-0.0008110230816780005,-0.121266948395244,-0.019805801834749663,-0.013271044716624917,-0.043239349859063345,0.11213501179131977,0.06102390520194048,-0.044944553566934026,-0.11351958835203016,0.05826405291444051,-0.036902382060713924,0.12110445153016725,-0.06052200761580421,0.0791044180233183,-0.0012676553124595096,0.038134647036663444,0.04029300436847641,-0.07788393669393719,0.013398242088894256,-0.08004275859444752,-0.022415109221907842,-0.00964635715393348,0.04565720548492133,0.005033840115806507,0.02262771155326658,-0.023901421654476274,-0.0009309547595974341,0.019465609565068036,-0.12265753665623141,-0.01396508747758613,0.018728472228476935,-0.03994345439018768,0.05219184848545421,-0.039076848309921204,0.017284396850510076,-0.07680630437636278,-0.017630545228251027,-0.006412636351921658,-0.09137871507342213,0.007773800829825587,-0.05504052407241225,-0.004807595319443546,0.049826592780571666,-0.029953686018443552,0.010127696808521302,-0.04681633965572017,-0.06640365082901041,-0.016829513170833883,0.015526614361725468,0.012693845301145193,0.013928837838646686,-0.05188898868474259,0.03201516602534666,0.035790948238024575,0.013537249020950524,0.03793839846789227,-0.07843222774056145,-0.01649367187624444,-0.015225653093514643,-0.0026082694951707714,0.023309247195369566,0.005976270409615517,-0.020917436039439512,-0.045157731987881665,-0.023409380161634952,-0.05424412050503461,0.013414079211539875,0.04196771522905319,0.014712214590509047,0.026714989327242665,0.012108050359838758,-0.008670240921053413,0.054418097872831174,-0.03823517847603004,0.024411261787869544,-0.0075824074146234755,0.0322398394207868,0.04814067170038046,0.042028368916231906,-0.0026384470696091413,-0.019563568701554405,-0.008483686068190222,0.027792926517468192,-0.028275697885141567,-0.012749767663780217,-0.03360386769789048,0.013839808911034009,0.014266288633715379,0.017621155174275684,0.005070253742204905,0.035616693587359124,0.01681150618127529,-0.020455433424134955,-0.02840781192235952,0.006385680211800249,-0.0034095417908696153,-0.03517740203740728,0.007547120598070398,-0.01807807410947717,0.038459968918268084,-0.018520330514639343,-0.022853077512997737,0.014840038163905256,-0.011128954300531384,-0.019374681044703627,0.027495144288726906,0.012709580556249985,0.028361072412354457,-0.034865625878193605,-0.031196232536462407,-0.016594476677760307,-0.01642004776876881,-0.07708081158398528,0.048714917560795545,-0.025866562530777078,-0.002420994693522847,0.01629823793278004,0.02117895603196509]},{`id`:'chunk_ec7059cdbad1b7cc8a9664d6',`document_id`:'summary_idf2025_smbg_cgm_001_fabddc14df83',`title`:'IDF 2025 - Hai loại công nghệ tự theo dõi glucose - Trang 43–44',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'Theo IDF 2025, tự đo glucose máu đầu ngón tay (SMBG) và theo dõi glucose liên tục (CGM) là hai phương pháp khác nhau. SMBG cho kết quả glucose mao mạch tại thời điểm đo, còn CGM theo dõi glucose dịch kẽ, thường cập nhật theo khoảng một đến năm phút, giúp quan sát xu hướng dao động. CGM có thể giúp nhận biết những thời điểm tăng hoặc giảm glucose khó thấy bằng các lần đo rời rạc. Tuy nhiên, việc dùng thiết bị và tần suất đo phải phù hợp bối cảnh chăm sóc, đặc biệt ở người có sử dụng insulin. Dữ liệu thiết bị là thông tin theo dõi, không thay thế diễn giải lâm sàng.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Hai loại công nghệ tự theo dõi glucose - Trang 43–44',`source_file`:null,`source_type`:'curated_summary',`source_version`:'fabddc14df83',`embedding`:[0.17926417541526518,0.07291043995743786,0.48043374404952804,0.453726109159879,0.5509796092477106,0.003705783174803466,-0.03991217721808649,-0.01636001661329905,0.04661964659175838,-0.013582201529863272,-0.012978225253663852,0.048999470283378296,0.03267274467457328,0.004393866163621537,-0.011153777813800584,0.0006898145420267679,-0.03137760126904404,-0.03492851129062037,0.06910502077701047,-0.02628614185896577,0.009279281518663593,0.043167832267172114,0.004818274906946843,-0.10579897321519928,0.0887843363633465,0.005870207769565204,-0.022451045254700264,-0.014650294070726736,0.05774669628659513,0.05596711657889799,-0.00457008040364246,0.050022248868953956,0.012090907659585703,0.07433024510071155,-0.017899909312492406,0.0497713227844064,0.025560263522570438,-0.0015860139897210257,-0.061149907258729826,0.027639284211578203,0.040192225852956766,-0.05352630392322119,0.0031624537033419424,-0.024267257032688987,0.052244042084817914,-0.038340402068907715,0.01381300611055283,0.02136533965552672,0.060296877791195,-0.011572400440241541,-0.050182014675337554,-0.05873517819045271,0.0003525271877709346,-0.12143007517364722,-0.024200981072824486,-0.05986075122315503,-0.00930638296856363,-0.010566866404226865,-0.0045999014525312165,0.0033801687253409013,0.07794694711923829,0.028599392582792354,0.004316244344966144,0.039158531516080605,0.032407261436649286,-0.011499570613685556,-0.08276746459468022,0.02850575421988444,-0.06501350266744951,0.02631092788992112,0.04579573978848286,0.018776127173474436,-0.027572036714023692,-0.007886493075983034,-0.06366208676343495,-0.055368052916944424,0.03454704703008051,0.04662087801881157,0.011240055728191492,-0.013173850961824763,0.04484893603379347,-0.0059487433367906555,0.03162052547997045,-0.05054120840771402,0.03339965216597656,0.000207977242120607,-0.03377501737801154,0.030405015841704026,0.04802960212985872,0.04690573476146239,-0.004772848780662275,-0.02551879802584754,0.03577235926994309,-0.09821983724780677,-0.029650301928290625,-0.019364571360546597,0.06286951092927039,0.02217019927234015,-0.031954633087332894,-0.00262411693159194,0.04275165411344678,-0.04647646575256462,-0.0027686368579721015,0.01409465236142035,0.018762938089791806,0.016725509434030148,-0.042971665855002734,0.0037276337008692183,0.021531111352275034,0.0822539177833588,-0.027461605376437288,-0.08614681812699986,-0.055362123074641785,-0.0475079679617629,-0.06862195622576121,-0.06505452570171463,0.03051419066356484,0.02022458603228767,-0.049054525862020935,0.002042496332970806,-0.03629815935443111,0.03350677953364848,0.008295416583215061,0.05185730797031144,0.05005545286513779,-0.004651855517384788,-0.05230022140595374,0.07016743454268774]},{`id`:'chunk_b17f561e854f37828cc399c1',`document_id`:'summary_idf2025_cgm_metrics_001_6acd47f4ac73',`title`:'IDF 2025 - Chỉ số TIR TAR TBR của thiết bị CGM - Trang 41–42',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 trình bày các chỉ số theo dõi glucose liên tục (CGM) bổ sung cho HbA1c. Time in Range (TIR) là tỷ lệ thời gian glucose nằm trong khoảng mục tiêu; Time Above Range (TAR) là thời gian trên khoảng mục tiêu và Time Below Range (TBR) là thời gian dưới khoảng mục tiêu. Bảng đồng thuận về người trưởng thành không mang thai dùng khoảng 70–180 mg/dL (3,9–10,0 mmol/L) khi tính TIR, với mục tiêu chung trên 70% thời gian ở phần lớn người lớn. Bộ số liệu thường được đánh giá qua 14 ngày và thiết bị hoạt động đủ ít nhất 70% thời gian. Những ngưỡng theo dõi này không phải ngưỡng chẩn đoán tiểu đường.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Chỉ số TIR TAR TBR của thiết bị CGM - Trang 41–42',`source_file`:null,`source_type`:'curated_summary',`source_version`:'6acd47f4ac73',`embedding`:[0.18053905059715064,-0.006498541464742848,0.461366838927408,0.37823810625670357,0.4680770343218682,-0.013559864009597307,-0.025551247742703925,0.14183113617883494,-0.01308371084730231,-0.052384619900813584,0.16212392444139595,-0.03155392939638601,-0.06646380244366018,-0.056676797809444894,-0.0482278495933984,0.09289430008481803,0.07845983288995349,-0.0017416157479484037,0.0024405074791439977,0.05782075847134226,0.009531011936268832,0.1145903693746952,-0.16027110593984734,-0.013714874703062818,-0.06292213063085274,-0.003724068460335537,-0.061719668039415684,-0.10829538932971405,-0.030967146426135576,0.0812315903753301,0.01616591466901438,-0.10189717852262577,0.016999339743723047,-0.020122318166112423,0.020202858666281402,0.010501349569542483,0.07236328685045176,0.010823527950189806,0.00675381268811479,0.08190367062830242,0.045290092400181586,-0.028609822491820834,0.01437960939430391,0.025251556956845247,0.01665630943865866,0.010567634094242462,-0.017338729339448255,0.022686845965978208,0.017611168578840347,0.010512444769658777,-0.019754017245603772,-0.03444783864942212,0.00683574413583031,-0.1657548906884543,-0.036305689137224394,0.013938664245255633,-0.02748107187110843,-0.028027272042307903,0.10478951297722768,0.012807748868811964,-0.02542975152024758,-0.012963189440987875,0.00852038707865884,0.014460451709134908,0.027778566063578456,0.02651628142876378,-0.041503636077174576,0.03170431229879525,-0.01803912595152011,0.018195974121169,0.025478713873679643,-0.00954889690798706,0.05958576245209669,0.03684134701354158,-0.002410326346234203,0.017749478821199795,0.09030664842407178,0.060370457644712175,-0.041664403175392724,0.06426820600969055,0.05021078297913009,-0.05302758697694291,-0.025340617203894633,-0.04607445099101019,0.06578482216402438,-0.022708785660959626,-0.06429298404828039,-0.03295513075131252,0.10156743657864417,0.0038849358623141953,-0.05468102852823037,-0.027097736304698798,0.09275351607056495,-0.08145679976354468,-0.006235349189855009,-0.1168088141751164,0.009920862420097145,-0.07591975506693245,0.03843969155808801,0.04576420176504888,0.04184467113641322,0.06906744943255094,0.021373397939538536,-0.016646443664742442,0.05616352702410371,-0.02748639658755763,-0.0010464387163174422,0.013505496323206401,-0.0074155712985383435,0.08934852027740174,-0.09028031088479523,-0.052027625160895014,-0.007056155789154043,0.07029820200240178,-0.0307271664980187,-0.019466869236998016,0.03457701293838057,-0.013048624983258404,-0.01613091774447988,-0.004271619443498683,-0.01588652938148148,0.036230953355164686,-0.11174460478444834,-0.01025504570074662,0.07312383725529875,0.11866139628049442,0.03620483012533224,0.03282182585493062]},{`id`:'chunk_422be9f669043a4e292a6e65',`document_id`:'summary_idf2025_cgm_limits_001_0d09cf8da1ed',`title`:'IDF 2025 - Giới hạn bằng chứng và tiếp cận thiết bị CGM - Trang 42, 44',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 tổng hợp nghiên cứu về liên quan giữa các chỉ số CGM và biến chứng đái tháo đường. Một số nghiên cứu quan sát thấy TIR thấp hoặc glucose dao động lớn liên quan kết cục tim mạch, thận, mắt và thần kinh bất lợi. Tuy nhiên, nhiều nghiên cứu trong một tổng quan là cắt ngang và chỉ thu thập CGM trong thời gian ngắn, nên không thể diễn giải mọi mối liên quan như quan hệ nhân quả. Tài liệu nêu CGM đắt, khó tiếp cận và bằng chứng triển khai rộng ở type 2 chưa đầy đủ. CGM không thay thế việc đánh giá y khoa.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Giới hạn bằng chứng và tiếp cận thiết bị CGM - Trang 42, 44',`source_file`:null,`source_type`:'curated_summary',`source_version`:'0d09cf8da1ed',`embedding`:[0.14379501424356422,0.14190930924429523,0.46787672177272027,0.459899110476729,0.6087173244094947,-0.02648676532687423,0.09748415418319496,-0.043767278412210744,-0.09145940784076652,-0.03705068487711451,-0.03174569161849304,-0.0370157605658551