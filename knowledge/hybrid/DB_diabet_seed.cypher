36002838082863,-0.0017710465791200077,-0.024576996914745172,-0.00883327551408191,0.058628176569264605,0.03557572565467107,0.06501012361022131,-0.013817542104640928,0.02814558698293427,-0.01599504718899049,-0.0308225012797285,0.032678919688424866,0.025903885244993957,0.04748053665266467,-0.00044717692324380457,-0.0014225304025114452,-0.04433519814927015,-0.0037395073852211813,0.0046814504272843695,-0.032304293947516806,0.04313742381820596,-0.00975775252201158]},{`id`:'chunk_18d081c2a093b07da43dd65d',`document_id`:'summary_idf2025_asia_bmi_001_a1314f0511b2',`title`:'IDF 2025 - Bệnh type 2 ở người châu Á và ngưỡng BMI - Trang 76–77',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 nhấn mạnh người ở nhiều nước châu Á có thể phát triển đái tháo đường type 2 ở mức cân nặng và chỉ số BMI thấp hơn so với các quần thể khác. Vì vậy, sử dụng một ngưỡng BMI chung cho mọi dân số có thể bỏ sót người cần đánh giá nguy cơ. Bảng phân loại trong tài liệu nêu khoảng BMI thừa cân ở nhóm châu Á từ 23 đến 27,4 kg/m² và béo phì từ 27,5 kg/m², khác với ngưỡng dành cho dân số chung. IDF cũng nhắc đến vòng eo và bối cảnh sắc tộc. BMI chỉ là thông tin nhân trắc, không tự chẩn đoán đái tháo đường.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Bệnh type 2 ở người châu Á và ngưỡng BMI - Trang 76–77',`source_file`:null,`source_type`:'curated_summary',`source_version`:'a1314f0511b2',`embedding`:[0.11331593649627844,0.153266307104645,0.4452461950695859,0.4631081599143937,0.6346890547019339,-0.012304687183358514,0.1572238858068184,-0.03175727935980539,-0.13037810909708192,-0.013803273188772485,-0.021422955828477926,-0.08297844595515025,0.0068863200980126575,-0.0383601427379712,-0.04914267963999642,-0.015216711106432718,0.0037797814329420397,0.024576089880090645,-0.006897701705066349,-0.02026353740372031,0.017867317162558856,0.012722842622304917,-0.05103601655094792,0.024606649210476058,-0.024171034496344924,0.035411517567279976,0.05418230678291078,0.03653880532522179,-0.03413165030354247,-0.004997516119148953,-0.010866669076571566,-0.002506287336380232,-0.021795870429918405,-0.02172314961580847,-0.024340367793476033,0.002233421957880069,-0.028954219056203923,0.0060137486834405274,0.060038183305078464,-0.004042037505127174,0.026944576073178093,0.022267044990160165,-0.018463723725946134,0.041797607881309956,-0.07414449164584686,0.04091532316457484,0.009537594295470197,0.048004932383474176,-0.00658452901363499,0.0074374364493016735,0.0016172842012347874,0.0034906471315081103,-0.03229765278468293,0.025336749432742386,-0.051718670230653054,-0.015044867826185719,-0.035088469288038444,-0.024066130097001513,0.06905458548783554,0.056416751832165726,0.02257023783309771,0.01274422820761452,0.0476350495960055,0.012110513166079986,-0.004308577024879528,0.018031637469451193,0.022557354872442828,-0.0008462944808112949,0.058166813912651785,-0.016647496314934944,-0.06251230275849848,-0.01281784892226293,0.031281407407652104,0.0355552144526614,0.0303121961497439,-0.003689580180384934,-0.03145596397762552,0.03969227483722197,-0.056773152894535696,-0.015262570636487817,-0.011986307892315482,-0.012753394092984942,-0.006079863749821336,0.006378946240416552,-0.025977228954988885,0.002591490584185653,0.015917472688002133,-0.011259573588639262,0.006951204840590866,-0.036346549582728156,0.0036115726104917335,0.03241294058654077,-0.033834870669406526,0.004588121254101376,0.02151003824925019,0.010118314204952017,-0.0013746764352394307,0.019342210898168895,0.032541019557160586,-0.007593609549472367,-0.011160046814844617,0.0036742831809403126,0.013445763859612695,-0.03072169186847463,-0.011904857355710823,0.010373636156014698,-0.024580426005030825,0.014115763361224476,-0.00869549253991611,-0.031764860520353135,-0.02464595842734557,0.04253777293957485,0.0008053429150810018,0.02654130823775022,-0.00038548374394680406,0.020375723453921902,-0.01102965807458626,-0.038790461180041584,0.01773472532565953,-0.0687498362608707,0.02696743145678612,-0.009500954865187084,0.03659861884670679,-0.05583543226252891,-0.010945496959934308,0.025718173562646218,0.011191721742756466,0.014850079142032551]},{`id`:'chunk_4715a10a14edb9c0c51b499e',`document_id`:'summary_idf2025_weight_remission_001_f7dbaff397b7',`title`:'IDF 2025 - Giảm cân, glucose và khả năng thuyên giảm type 2 - Trang 76, 78–79',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 tổng hợp bằng chứng rằng giảm cân ở người thừa cân hoặc béo phì có thể hỗ trợ kiểm soát glucose huyết, giúp trì hoãn hoặc phòng ngừa type 2 ở người nguy cơ cao, và trong một số trường hợp có thể đạt tình trạng thuyên giảm bệnh. Tuy nhiên, thuyên giảm không đồng nghĩa khỏi bệnh vĩnh viễn; duy trì kết quả lâu dài có thể khó khăn. Tác động lên HbA1c phụ thuộc mức ban đầu, phương pháp và cá nhân. Không phải tất cả người type 2 đều thừa cân. Vì vậy, kết luận về giảm cân không nên được áp dụng máy móc cho từng cá nhân.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Giảm cân, glucose và khả năng thuyên giảm type 2 - Trang 76, 78–79',`source_file`:null,`source_type`:'curated_summary',`source_version`:'f7dbaff397b7',`embedding`:[0.15570308166797606,0.14553079646185477,0.5058384272123515,0.4771609890766898,0.6021503502284183,-0.01608392367130526,0.0801812649310119,-0.009371711539144342,-0.05685215937402723,-0.055046703245522056,-0.04995441900939523,-0.07625195298209267,-0.004299319509742407,-0.038987233089407825,-0.03857451579081437,0.011718506979042729,0.011508143185099249,-0.03834549623144025,-0.03793099813879974,-0.009408950139601012,-0.019815052817488757,0.05318588565784879,0.006508641152829471,0.04499586258298969,-0.016680431160199332,0.030022572679937333,0.03949306596428302,0.0077032903644942315,-0.0003616452823448652,-0.046765100248051965,-0.02741854215855589,0.018954053851046895,0.012795073135475411,0.004353227013073217,0.008843722290157646,0.018434937488474024,-0.006096842957704237,-0.0039202122021869176,-0.04354894897761194,-0.008583324807784929,-0.006943922174909239,0.001985807040038131,0.027850343788008842,-0.015811077712328137,-0.027028850798194694,-0.012097508290272768,-0.0320815090168195,0.02620187858518614,-0.04787522784190864,0.01973206060500497,-0.018392393723147462,-0.013865045210607706,-0.00956027340339556,0.045399320549502895,-0.017746759061165723,-0.012570370839203622,-0.01661466790272558,-0.007827370123112881,0.014469324263129054,0.008843106112860174,0.00694137432483444,-0.0466098547990218,0.043751469753009156,0.034007759940620684,0.0033662261924269675,0.02375574680938269,-0.052041374175948014,0.004314074696550892,0.0460166939107812,-0.006814152232581549,-0.012873623444405098,0.026965918643507933,-0.03864239461330917,-0.02718117245707056,0.015954085562009047,-0.040495750419373144,-0.011183203506133827,0.05008666156147025,0.020172193854199747,0.0006666422769419638,0.022027039538615838,-0.06240621226700968,0.018966392783839846,-0.006732744050939558,0.013390315343762234,-0.040824763262244185,0.0226653458532437,0.0358226265663312,0.011437775353986452,-0.006219035799388777,-0.00837097576329966,0.02063154214848092,-0.030865196302333787,-0.01440058328267513,-0.001014036349394923,-0.021493214884181294,0.005771670219910938,0.00917002571504042,0.035362286834965846,-0.009380511489037466,0.03683303916078898,-0.0169587765592748,-0.013060914191190657,0.014035931107811619,0.02009747193258528,0.04484049965461985,-0.0024151665395933147,0.006323544876285731,0.0017273944655880487,0.03427785550457917,-0.03284959513315835,-0.05042979847523372,-0.0077513125102100485,-0.00543875747155552,-0.007370246875877385,-0.015847582294529736,0.022143474409939457,0.04287889118069108,-0.054281394388059616,-0.036949703098950376,0.002702166993798686,0.002743905740085531,-0.013081331833337425,0.05931743071651362,-0.012391711494388037,-0.009136178793417141,-0.035034151009048595,0.06470550200929549]},{`id`:'chunk_3041a65e0363cd4a276e77ab',`document_id`:'summary_idf2025_cardiorenal_multifactor_001_fb31ecda2d31',`title`:'IDF 2025 - Yếu tố cùng góp phần vào biến chứng tim thận - Trang 88–89',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'Theo IDF 2025, biến chứng tim mạch và thận trong type 2 phản ánh tương tác của nhiều yếu tố, không chỉ tăng glucose huyết. Những yếu tố liên quan gồm tăng huyết áp, rối loạn lipid máu, béo phì, hút thuốc và ít hoạt động thể lực. Các vấn đề thường gặp gồm bệnh tim mạch do xơ vữa, suy tim và bệnh thận mạn. IDF cho rằng cần đánh giá nhiều yếu tố nguy cơ cùng lúc và không thể dùng một chỉ số glucose duy nhất để mô tả toàn bộ nguy cơ biến chứng. Bệnh thận mạn có liên quan thêm với nguy cơ biến cố tim mạch và nhập viện vì suy tim.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Yếu tố cùng góp phần vào biến chứng tim thận - Trang 88–89',`source_file`:null,`source_type`:'curated_summary',`source_version`:'fb31ecda2d31',`embedding`:[0.1556151848669056,0.12362889688356181,0.48136815164769214,0.4573379305216415,0.5966140420268418,-0.021708526376207887,0.07639583269426171,-0.0385734299066401,-0.06509814273038413,-0.03067750844075314,-0.02325802334098297,-0.005559651366647818,-0.014290404463308396,-0.05637117185312136,-0.030805614844243188,0.0020301969270685822,0.01684665898416786,-0.022292879114112672,0.05836010219938652,-0.05648954310965683,-0.0017885067258084516,0.049183325827417516,-0.050740439678415974,-0.0215030029240979,0.0026477272457717006,0.019614203153490894,0.022592952028053632,0.012366011528892955,-0.005886712218498967,-0.005082500662391664,-0.02835867994797526,0.029576486637433674,7.769648651731634e-05,0.025535532474205664,-0.007585710100140741,0.04416685541957568,0.006163014606030125,-0.03172624078063766,-0.015204494279189053,0.019299299265442497,0.07285050405932685,-0.017638123991142004,-0.008788114463603183,0.005107700885256498,0.0009325729242398497,0.03314119607071179,0.013420464726730466,0.047692821161887694,0.00025204955986507006,-0.012972635547025395,-0.0075819689500993045,-0.018419480730780022,-0.03487738888323328,-0.04469019684521861,-0.05726936718151911,-0.02188556614234793,-0.036566953423937044,-0.03785069547830994,0.07392403699319833,0.0446466052784654,-0.002871376261182178,-0.034880630354491335,0.04044152557090432,0.020926309572737833,0.0023905232750866894,0.02343031852650613,-0.03921507432115893,-0.010776489150906768,0.025073863444033825,-0.01097242237618537,-0.026608196341030944,-0.02189555229893853,0.01586855019341253,0.018163730055981125,-0.02137878954817147,0.012862395677626514,0.045460150583304,0.09720510548843565,-0.06957395036593983,-0.01181041982332533,0.03503671603446259,-0.029392578602163082,0.015200852045354155,-0.027319389801220596,0.026673064809568044,-0.02714044646940223,-0.022695544016709066,0.04442051800791108,0.009222832942622695,0.0077343822635702365,0.02877263783243246,-0.02424523841348364,0.006411637272923682,0.00037096153533535905,-0.03145432029912397,-0.038869926649857674,-0.012337682302669153,0.02843554716866113,-0.05385213895131086,0.03885789955902614,0.0009567699053653968,0.0023057373776982065,-0.07600808095515901,0.012305877744346884,0.013891452973717525,-0.08482991565801001,-0.018966763219614168,-0.03296310209722205,-0.05794499244600192,-0.004029155640505449,0.05396872478327462,0.010489426611062728,0.07644655273458134,-0.01714383928228315,-0.010377472643860528,0.01610636974755305,-0.07923921742259588,-0.012848284811950893,0.021890859743892356,0.032839589286341855,-0.029059311823009585,-0.037077603096049606,-0.047546681460336866,-0.02642032746202647,-0.027347252379178424,-0.08051536207122874,0.09185482797922422,-0.025989584657323466]},{`id`:'chunk_594cbc5e947753310468e8f7',`document_id`:'summary_idf2025_ckd_screening_001_4a8138567fbb',`title`:'IDF 2025 - Sàng lọc chức năng thận ở người type 2 - Trang 87, 91',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 trình bày đánh giá bệnh thận mạn (CKD) ở người đái tháo đường type 2 bằng hai chỉ số chính: mức lọc cầu thận ước tính (eGFR) và tỷ lệ albumin/creatinine trong nước tiểu (UACR). eGFR phản ánh chức năng lọc của thận, còn UACR đánh giá lượng albumin bị thải qua nước tiểu so với creatinine. Tài liệu nêu eGFR dưới 60 mL/phút/1,73 m² là dấu hiệu giảm chức năng thận; UACR từ 30 đến 300 mg/g là albumin niệu tăng mức trung bình. Đây là các dấu hiệu cần diễn giải với bối cảnh lâm sàng và tiêu chí bệnh mạn tính, không đủ để tự kết luận bệnh qua một chỉ số đơn lẻ.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Sàng lọc chức năng thận ở người type 2 - Trang 87, 91',`source_file`:null,`source_type`:'curated_summary',`source_version`:'4a8138567fbb',`embedding`:[0.16377990619344293,0.12291488852411177,0.42244938428832124,0.423901021603283,0.5680414530040927,-0.025206747380579732,0.12495285830523585,-0.0362994178285731,-0.14465542903782505,-0.011028645848873324,0.009606667438625144,-0.037634722338106254,0.0200127164924679,-0.03280920754965193,-0.044386288421828984,-0.02889910997524507,0.029636872933072385,0.01915561508918717,0.006026447503312184,0.023400451235551435,0.04609405663986226,0.030698850035929023,-0.07273356002854843,0.05128254372865762,-0.05709191409309175,0.06044058323368954,0.02678194243495841,0.007877388979104361,-0.04513467386112309,0.025286724006972846,-0.03905751102982664,0.003150713473239557,-0.028212061156417965,-0.05373940348851253,0.014353507480345393,-0.009466859862873066,-0.02472186429851758,-0.010205485403497631,0.09656073349776766,0.009296305709604777,-0.003982861621852783,0.016927102797507185,-0.05987332551900875,0.05735088068440724,-0.05848636609447201,0.008686696205880366,-0.005262901920914638,0.11323458464417213,-0.033179811234602535,-0.050713367244199635,0.036663411083137226,-0.018521340748439707,-0.05241011538787798,0.05902477869811886,-0.08696306742964935,0.03449563193736748,-0.011158049935980976,-0.033303255067982124,0.07205697300755126,0.07533139603672732,-0.04890667792965316,0.013916958758787712,0.03055395590124971,-0.04299041547254777,-0.029284020919673213,0.026857407268143528,0.050269825471341435,0.0009949232144420333,0.12307129087011412,-0.05949450782047508,-0.0440395464369491,-0.0005947140080997837,0.027655907862378877,0.05860606297917081,0.0579643829757838,-0.04771881823510184,-0.05402912897842503,0.005531647562456677,-0.09755188506263159,-0.027065515671200753,-0.006582291406512253,-0.00045927923181100837,-0.019059078929031067,0.01811994748496256,0.030113931906211113,-0.00832873819352604,0.01800378388337916,0.004025582401832276,-0.06584646713599676,0.006906428640344377,0.011843116118720715,0.016263655437197544,0.02174452332743718,0.006568250626826248,0.019214905813261993,0.04807279576112714,0.02507185468336862,-0.020685817164315216,0.08651610381105777,-0.0025439921191362327,0.019997806011557793,0.017774489002068045,-0.011009494936488309,-0.06153817813975812,0.0449757470851126,-0.01467991667704321,-0.0785612690976149,0.03337837509001648,0.05037202933611229,-0.052769674191339905,-0.025681768533736098,0.01218035699441521,-0.01825508717614697,0.027220468082728645,0.022599057114319438,-0.014449901369035085,-0.008199548323531565,-0.044981461155228435,0.09109777774510866,0.008526959186872338,0.04908673259407058,-0.005274482695119562,0.05787437626090584,-0.07079174159089262,0.06229169530862408,0.07541566118949918,0.10946611809984028,0.03799631309385242]},{`id`:'chunk_515c776043a8cb0913489e90',`document_id`:'summary_idf2025_cvd_hf_screening_001_3cf63e7a514e',`title`:'IDF 2025 - Sàng lọc bệnh tim mạch và suy tim ở type 2 - Trang 91',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 nêu đánh giá nguy cơ bệnh tim mạch ở người type 2 không chỉ dựa trên glucose huyết. Nhân viên y tế xem xét triệu chứng, tiền sử nhồi máu hoặc đột quỵ, tuổi, huyết áp, lipid và bảng điểm nguy cơ tim mạch. Với suy tim, có thể xem xét triệu chứng, tiền sử nhập viện, điện tâm đồ, siêu âm tim và BNP hoặc NT-proBNP. Tuy nhiên, IDF lưu ý chưa có sự thống nhất phổ quát về quy trình và ngưỡng sàng lọc suy tim bằng các chỉ dấu này. Đây là đánh giá chuyên môn, không phải phép tự chẩn đoán.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Sàng lọc bệnh tim mạch và suy tim ở type 2 - Trang 91',`source_file`:null,`source_type`:'curated_summary',`source_version`:'3cf63e7a514e',`embedding`:[0.1361710526184474,0.14901966033690175,0.46456275364460836,0.45968352573115023,0.6096105911624723,-0.023067314545100435,0.10159027134236738,-0.03324024761284482,-0.08595277914016772,-0.0349578521046242,-0.022868672844031653,-0.03168964116396716,-0.025792448256343834,-0.04215234054221312,-0.0454532009464939,0.006117204225139794,0.008001608257611826,-0.0010764776112633966,0.04084773731660491,-0.044225908918978936,-0.009458546243678572,0.04339707472183409,-0.047437382829224134,-0.002114113311176191,-0.016280159694074207,0.03304692422450606,0.03828890238896854,0.021204144268769008,-0.023312333809776844,-0.005974498068983864,-0.011812191232934652,0.030545616209068458,0.0015588163876414916,0.02430746393081194,0.0003302156609527678,0.031028557947637366,-0.013459302017312689,-0.010514041484860528,0.003106508501835435,0.026209808108589486,0.05533948925876295,-0.007528721304615267,0.016654642955891107,0.02112565649846416,0.0007896521073258025,0.023254406284982165,-0.006409749973789807,0.031077199696400205,0.0048295965371678426,-0.025520313194745226,-0.0002802448804694443,-0.012238196725692513,-0.0325254823314714,-0.034377773746768404,-0.09050907081579515,-0.007125775362309065,-0.027832988310052018,-0.031167813095950108,0.058738911173946924,0.042724519644104966,-0.041878561855582266,0.008083515217515158,0.031177484741296065,-0.026493978194463225,-0.011189983955689865,0.01665121607333954,0.006240809669704546,-0.014280267509527598,0.0299921355965817,0.017458810208912035,-0.02132400430251222,-0.018607799481682157,0.03011239845227127,0.004868160170692989,-0.02496000310694902,0.002606300500611142,0.038701553522147956,0.02366603254386683,-0.015286834531619617,0.020964104931473493,0.016218427126029722,-0.005671576942246418,-0.02643496306442965,-0.015212434039179322,0.04042930348252135,0.002028383108424198,-0.014443466386870123,0.042009395742919314,0.026709866167644782,0.001758025456139331,-0.026925339132620078,-0.034303447348353056,-0.02536488661752256,-0.003779958381370953,-0.047957591780266276,-0.028358607215769348,-0.008916494887344157,-0.037285372693228507,0.007347616040501064,-0.015800209833503616,0.0250121820295847,-0.013836749567611955,-0.014565720211033091,0.012897886373181792,-0.07236973438310239,-0.06295822627265703,-0.024630703225198874,-0.025743609357929294,-0.0709653008782194,-0.03725369064442958,-0.04130152852806158,-0.002478854651493904,0.007719572959265452,-0.021525709403611128,-0.03527082322466106,0.1031441118741159,-0.04739810824340473,-0.0869696428049115,0.03520371567330124,-0.007443616624474491,0.051450399586456357,0.02718278444963205,-0.011049144696559989,-0.10438782651221351,-0.06837716869467282,0.025655352439010053,0.07657673182726751,-0.049099188715161425]},{`id`:'chunk_1ebf7f96a223bebce3fd3e64',`document_id`:'summary_idf2025_masld_definition_001_2bbf9bf1b039',`title`:'IDF 2025 - MASLD và mối liên quan với type 2 - Trang 102–103',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 sử dụng thuật ngữ MASLD cho bệnh gan nhiễm mỡ liên quan rối loạn chức năng chuyển hóa, trước đây thường được gọi là NAFLD. MASLD đề cập tình trạng gan nhiễm mỡ trong bối cảnh có ít nhất một yếu tố nguy cơ chuyển hóa và không có mức tiêu thụ rượu gây hại theo định nghĩa tài liệu. Bệnh liên quan chặt chẽ với type 2, tiền đái tháo đường và béo phì. Phổ bệnh có thể gồm gan nhiễm mỡ, viêm gan nhiễm mỡ MASH, xơ hóa và xơ gan. IDF dẫn một phân tích ghi nhận MASLD ở khoảng 65% người type 2, song các mẫu không đại diện mọi quần thể.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - MASLD và mối liên quan với type 2 - Trang 102–103',`source_file`:null,`source_type`:'curated_summary',`source_version`:'2bbf9bf1b039',`embedding`:[0.1232