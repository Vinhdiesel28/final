902983439,-0.004799795681381985,0.036376274349216114,0.04996420374692109]},{`id`:'chunk_fc3bea7522b512956c8077dc',`document_id`:'summary_dia_hyperglycemia_symptoms_001_0f4533fd5e39',`title`:'Diabetes in America, Chương 1 - Tăng glucose và triệu chứng - Trang 1-2',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Khi glucose trong máu tăng đủ cao, glucose có thể xuất hiện trong nước tiểu và gây lợi niệu thẩm thấu. Quá trình này làm người bệnh đi tiểu nhiều, mất nước và cảm thấy khát nhiều. Sụt cân cũng có thể xuất hiện khi tình trạng tăng glucose rõ rệt. Ở đái tháo đường type 1, triệu chứng thường khởi phát nhanh hơn, trong khi ở type 2 nồng độ glucose có thể tăng chậm theo thời gian. Vì vậy, không có tiểu nhiều hoặc khát nhiều không loại trừ được bệnh, đặc biệt ở giai đoạn sớm của type 2.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Tăng glucose và triệu chứng - Trang 1-2',`source_file`:null,`source_type`:'curated_summary',`source_version`:'0f4533fd5e39',`embedding`:[0.16677512960055535,0.15242992387172732,0.5109774703012719,0.43159769443473367,0.5545906666791138,-0.08495882961291239,0.029792194776937946,-0.046461427392385984,-0.023317412875797004,0.011127977800365991,-0.052029760484223184,0.04068601212331644,0.02331640625691887,-0.06890035730516664,-0.028068280913411747,0.020642092880337113,-0.002703084004325896,-0.054849237297455486,0.030318670077064905,-0.0513581276325578,-0.04423559526935109,0.02174776441941904,0.01194963765178456,-0.04409304005079908,-0.0036682430593900656,-0.060709111749966085,-0.017054828939395902,0.004053287875446076,0.05392656842197907,-0.008453335800998503,-0.028108358515739788,0.03289360970941688,0.055951944948448316,0.04219735496393123,-0.009168023327611536,0.06417710937786536,0.025779739415369745,-0.03368043969565886,-0.050225712977530174,-0.03680014220189405,0.0036351252867452204,-0.04152378135466707,0.016137769668135855,-0.04847958537175629,0.09520072004347735,-0.02829135740091694,0.01178537253007098,-0.057673513903669635,0.028327045876772605,0.011506681547626164,-0.006214279690233498,0.01289361759791971,0.038326069117608746,0.012763758584085861,0.07499334647476377,-0.023775403570895033,0.026167584468310388,0.07503010538520326,-0.05105248536277971,-0.10240649986349581,-0.008047637968845502,0.002099663360222956,-0.09667233929174461,-0.033347994596734425,0.0008792662367651175,-0.04237314180704846,-0.007428917974951344,-0.07690031018358762,-0.029303791824729288,-0.01531818119725554,0.008727531265805052,0.028484381002205194,-0.010873880131971542,-0.046158701144640955,-0.0370514222741997,0.030028794396777903,0.08831162343009025,-0.04405052446112151,0.06453173817974141,-0.024716131952195464,0.0024374346630262893,0.004276164466544287,-0.0027400541426858835,0.021771356862146284,0.030519557673935334,-0.01050457104164739,-0.019681055656082434,0.03451771534623343,0.02090513980860096,0.04091042547275994,-0.02096086546973164,-0.02386981788789326,0.007778553921697496,0.06177089053583177,-0.0133602494612139,-0.03852481751710935,-0.022418807846560734,0.02887466350202801,-0.01089900401634589,0.029296774778780454,0.04398052238515247,0.01980081720511757,-0.045455979926097304,-0.004407053294001257,-0.009030558293475923,-0.04337630212717299,-0.07612589955142038,0.0028262266468029136,-0.01722918008753886,-0.03127614348375686,0.016954557657457184,-0.0006054785257706653,0.044895410316509,0.008882114281167875,0.018662531017287456,-0.029057016918108955,-0.09945275286282206,0.05275877182230858,-0.014054779533254552,0.012452286391432208,0.026742901994603042,-0.02413964390327168,0.023193245257588885,0.024560458484200933,-0.007506996574593015,-0.025437970854368382,0.06411438426933017,0.026586219011989744]},{`id`:'chunk_12aa0a2ba52581435ec556bc',`document_id`:'summary_dia_type2_asymptomatic_001_4e89e47c09f6',`title`:'Diabetes in America, Chương 1 - Type 2 có thể ít triệu chứng - Trang 1-4',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Đái tháo đường type 2 có diễn tiến lâm sàng đa dạng: có người không nhận thấy triệu chứng, có người chỉ biểu hiện nhẹ và cũng có người đến khám với tăng glucose nghiêm trọng. Bệnh thường tiến triển chậm nên triệu chứng kinh điển có thể chưa rõ ngay từ đầu. Béo phì, tuổi trung niên hoặc cao hơn và tiền sử gia đình có thể xuất hiện thường xuyên, nhưng không phải tiêu chí đủ nhạy hoặc đặc hiệu để tự kết luận mắc type 2. Tài liệu cũng ghi nhận bệnh có thể gặp ở người gầy và người trẻ tuổi. Đánh giá cần dựa trên xét nghiệm thích hợp.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Type 2 có thể ít triệu chứng - Trang 1-4',`source_file`:null,`source_type`:'curated_summary',`source_version`:'4e89e47c09f6',`embedding`:[0.12867299938383508,0.16287253102994317,0.4835112433137505,0.41977934678259404,0.5988886885125754,-0.08111290549002771,0.08782751476622751,-0.060934956308933176,-0.07069439613830972,0.008801987387726223,-0.05533184181799526,-0.022679983660715965,0.03097593826933341,-0.04105163348016283,-0.04454185716686641,-0.0006690650222150667,-0.007650349462956248,-0.03131808920255751,0.015367092291980633,-0.015335319821689229,-0.039558277795586634,0.0012640594118425246,-0.016925233377951626,-0.015511162022865323,-0.019470729750460502,-0.04084895088396176,0.011890670778742238,0.017372467833076763,0.017797708521566192,-0.0036402732036027213,-0.012261963314695819,0.024990688422589186,0.03965250851598986,0.018756794714086502,-0.007366654764281787,0.04379876968484558,-0.005785450388523722,-0.008627912554901133,-0.0038490139697496344,-0.029544052648336896,-0.03195910731700441,-0.014369910700468834,0.01753173237653751,-0.007080797527128993,0.0758174882285605,-0.004324074574566604,0.007899606010448377,-0.06724438809616738,0.020913365283622073,-0.015956651816763846,0.011085955334456898,0.05093194004677486,0.017799775115279443,0.04568613222017771,0.052587563497071936,0.0027344829740269787,0.027904333699984334,0.08783994286664656,-0.055543535568796994,-0.07957811011609218,-0.035915129006123654,0.032916955328318356,-0.09645519398357068,-0.07413940050362655,-0.020566006055356655,-0.03562679691812568,0.05260914475917763,-0.05833663501843855,0.008230108878609118,-0.01167329032092517,-0.010054186193853006,0.026876310567743672,0.01152166523033854,-0.040486220393659206,-0.016463329630047333,0.03207165268220958,0.04167822344154346,-0.09006932211190402,0.08062432116017217,-0.014232343130033331,-0.01677182514067742,0.030745302769726635,-0.030051085421731422,0.0308211200442373,0.01602893118353401,0.01647192732712198,-0.007693231657018223,0.016231711424814648,0.009451511441099732,0.034326537572179266,-0.05055400175964299,-0.017839691554935314,-0.023474618264319257,0.06575612173843037,-0.009587501770279458,-0.015334145308815692,-0.033935125006085,-0.025157325455737154,0.011175737106575772,-0.012341395763978087,0.035767359087649324,-0.000516013707554762,-0.001753950636286897,-0.011013754889076981,-0.06975229216790606,-0.022939033319782098,-0.05821923253359136,0.008812439631903396,-0.045809551896614474,-0.06904293973557106,-0.007351550253302191,0.02828696720783857,0.01573090153791705,0.0009995145626880894,0.011602806145707136,0.04725546059494227,-0.07658837437791333,-0.01822723164122936,0.005242518460239717,-0.023053989010914773,0.07060327354599785,0.022395609253432924,0.02725442600534164,-0.06402096118232847,-0.04518906697386337,0.03304548511416964,0.05314386367770025,-0.04208656417482564]},{`id`:'chunk_119d95640ea32e92b179d858',`document_id`:'summary_dia_gdm_risk_001_c4c8d73ac54d',`title`:'Diabetes in America, Chương 1 - Đái tháo đường thai kỳ và nguy cơ về sau - Trang 1-4',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Đái tháo đường thai kỳ là tình trạng đái tháo đường được ghi nhận trong thai kỳ theo cách phân loại của tài liệu. Trong nhiều trường hợp, khả năng tiết insulin không đủ bù cho tình trạng kháng insulin gia tăng khi mang thai, nhất là ở quý hai và quý ba. Rối loạn glucose có thể giảm hoặc hết sau sinh, nhưng người từng mắc đái tháo đường thai kỳ có nguy cơ đáng kể phát triển type 2 về sau. Tài liệu cũng phân biệt trường hợp type 1 hoặc type 2 đã tồn tại nhưng chỉ được phát hiện khi mang thai; chúng không nhất thiết là đái tháo đường thai kỳ.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Đái tháo đường thai kỳ và nguy cơ về sau - Trang 1-4',`source_file`:null,`source_type`:'curated_summary',`source_version`:'c4c8d73ac54d',`embedding`:[0.1823860638945268,0.13658999873388797,0.4415480480530896,0.44540005622857143,0.546773157310718,-0.03631397075072357,0.0013319591628828122,-0.13346332691994214,0.05194826827192803,0.1012345572779412,-0.038423089300048036,0.0200211323345289,0.20090631086734267,0.06958633802420046,0.02286855145664993,-0.04599816777828095,-0.027175335130647422,0.03037156107715686,-0.00475626161024605,0.04745536947886531,0.04263989169414846,-0.030943912323622067,0.06458295561694552,-0.07335611680400782,0.05871576348971828,-0.04619762486964503,-0.0449646004988473,0.05102383436773646,0.06661041279631913,0.0790469631608588,0.0011635739782224585,0.015173007377275652,0.009194282432679118,0.006436363562632529,-0.009335910418308281,0.0078096602497857645,0.03185490031349869,-0.02253636016853721,-0.0036213436118478293,-0.051201506246871475,-0.0823650303398769,-0.03712477035464332,-0.019803335402364838,-0.032666237146487545,0.015244994820805097,-0.06282864007756898,0.051975977818053895,-0.08113371990937142,-0.004079427612187967,0.010275001927530888,0.004112293225254962,0.08255536555397498,0.03274510454184114,0.0520029234467537,0.0918433715039467,0.040293556498628084,0.025903732712758153,0.08786659227283074,-0.058634187021356955,-0.05338050003361333,0.019036518648132644,0.033204527977779806,-0.11203357783264023,0.01837403044936322,-0.016232023528268382,-0.021880390869474072,0.04099415292966142,-0.010088218197741977,-0.00011670532286482753,-0.026314227988233827,0.0015777103316725585,0.07473585134603644,-0.0051542269717735276,-0.0204171704331898,0.035363720577715786,0.044498066890730985,0.010460102562522099,-0.039062965773622206,0.047057335377490454,-0.026660377405378476,-0.046350477953032536,0.024732386032702974,-0.014619178327280777,-0.0019469343851256204,-0.03770553548036206,0.02016425530177316,-0.03185370300072638,-0.028735310798116587,-0.04654892584763793,-0.00971307455134412,-0.033660858791870016,0.005517571109166312,0.0556550111673397,-0.003513674225867004,-0.011248637820741751,-0.0053434561290132245,-0.030722223211004155,-0.002899333832940344,-0.03412482212131833,0.03303643795029198,-0.03445105223218798,0.01146088618002427,0.0033096516358771463,-0.046196695959564514,0.018644876184369736,0.009843719487199632,-0.008458611466079834,-0.018419605625505413,0.003385308807902891,0.024155610198239447,0.022631247423488998,0.018901613145467712,0.0147345084691235,0.024768236635945833,-0.017860837057026187,-0.010567080427786741,-0.06545023706150305,0.07550143956138437,-0.035388827202625636,0.016141460918774844,-0.016744609967597655,0.012892733753078214,0.047180843336445025,0.03306169421887927,0.01500860600891206,-0.01366562684214757,0.05024480693235141,0.020391789373724566]},{`id`:'chunk_8e57d71500baaacea66c95e2',`document_id`:'summary_dia_complications_001_545188af9c82',`title`:'Diabetes in America, Chương 1 - Biến chứng vi mạch và mạch máu lớn - Trang 1-4',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Đái tháo đường type 1 và type 2 đều có thể gây các biến chứng vi mạch liên quan đến mắt, thận và thần kinh. Những vấn đề được nêu gồm bệnh võng mạc đái tháo đường, bệnh thận đái tháo đường và bệnh thần kinh do đái tháo đường. Cả hai type cũng liên quan nguy cơ biến cố mạch máu lớn do xơ vữa. Thời gian mắc bệnh và mức tăng glucose huyết đóng vai trò quan trọng trong sự xuất hiện biến chứng, nhưng mức độ và diễn tiến có thể khác nhau giữa từng người. Có nguy cơ biến chứng không đồng nghĩa mọi người mắc đái tháo đường đều sẽ gặp biến chứng.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Biến chứng vi mạch và mạch máu lớn - Trang 1-4',`source_file`:null,`source_type`:'curated_summary',`source_version`:'545188af9c82',`embedding`:[0.14091872297275188,0.16171175893979214,0.4856666131132156,0.41424990232680253,0.5929555919708929,-0.07041461965074006,0.09300466350963947,-0.0810586934517845,-0.069232467985322,0.006088190514155225,-0.06001378437619473,-0.01091692877755007,0.040955198462248765,-0.045806287631101505,-0.0410844268509807,-0.012846008820331403,0.003917147951326716,-0.01715198754270565,0.015555184955486965,-0.004595268624804448,-0.023867750472772696,0.003264300407481517,-0.027496113813643336,-0.011617651856524336,-0.023177736364283,-0.03933296216101539,0.014554938760326088,0.012691529418698317,0.00785280183356545,0.005525978990844447,-0.03287247647921496,0.025736313671226984,0.030161444828780606,0.010317194896480053,-0.023383559015209374,0.04935023374325902,0.008289868396591318,-0.01761503641691226,-0.0033984368463314436,-0.03080811946014903,-0.009822439784891383,-0.010400117579173002,0.007172193888687501,-0.01133606712767675,0.06402919474156979,0.02496655426128122,0.0338552182929343,-0.03816415743320303,-0.006719250519609763,-0.009552133989943297,0.02063495041713788,0.043386710226189014,0.015446543043006699,0.07188534332800547,0.05935094856151944,0.018727273509594505,0.009581739693415222,0.07675627948099417,-0.02377129691362234,-0.0502177624362425,-0.044698590745684164,-0.014465556673424083,-0.06315654562223633,-0.04841272084402522,-0.01847855932662997,-0.027147655932216613,0.04951380831114524,-0.0657093403118244,0.014791047262471586,-0.052921487293878,-0.03867806109438511,0.030784457999375625,-0.0024678727773037997,-0.03820388667887339,0.02233380958162403,0.06325263331833095,0.04304769942989011,-0.00040115115512358995,0.020318217872135277,-0.024311362140116026,-1.7185745950837757e-05,0.013492248157278723,0.01255464707787468,0.03959200082794558,-0.010335440765168836,-0.015354867539302187,-0.027803726581456207,0.019292149394098776,-0.02820440506629428,0.024828892316974514,0.00847800990247322,0.012362449031826844,-0.007352331138744566,0.06705318594681026,-0.007687882015741403,-0.03769970076427263,-0.0406806439268191,0.018148815486533285,-0.05509380442046631,0.02466637257260147,0.005978767253941413,0.008338079195763543,-0.07246309936063358,0.015361167177360104,-0.012521720348658193,-0.0483719378279286,-0.010157653497118273,-0.016401164546309535,-0.058195129609619034,-0.07345408904114431,0.07682188019487544,0.06314387393101718,0.09058427686392836,-0.006470673825906345,0.02255231419802549,0.021673433592175228,-0.09679194482999345,0.03301334781820598,0.01532230723150076,0.02871769242534282,0.013634914284555565,-0.03871578640427578,-0.03678935428670769,-0.006123149510713586,-0.05390981550774198,-0.07679185706915753,0.09420240368676792,-0.06626159648174963]},{`id`:'chunk_4ca39ab768448c829bfcc4f2',`document_id`:'summary_dia_a1c_limitations_001_ded57533b8af',`title`:'Diabetes in America, Chương 1 - Yếu tố gây sai lệch A1C - Trang 1-11–1-12',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Kết quả HbA1c, còn được viết là A1C, không chỉ chịu ảnh hưởng của glucose huyết mà còn có thể thay đổi bởi đặc điểm hồng cầu và phương pháp xét nghiệm. Một số biến thể hemoglobin, thiếu máu thiếu sắt, thay đổi thời gian sống của hồng cầu hoặc suy thận có thể làm kết quả cao hay thấp không phản ánh đúng mức glucose thực tế. Mức độ sai lệch phụ thuộc tình trạng cụ thể và kỹ thuật đo. Vì vậy, khi HbA1c không phù hợp với glucose huyết hoặc hoàn cảnh lâm sàng, cần cân nhắc giới hạn xét nghiệm thay vì tự khẳng định có hay không có bệnh.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Yếu tố gây sai lệch A1C - Trang 1-11–1-12',`source_file`:null,`source_type`:'curated_summary',`source_version`:'ded57533b8af',`embedding`:[0.15815494278129924,0.04563376372487798,0.4934334084661795,0.33075052864053395,0.4450762682931578,-0.009161721583460148,-0.0653236827832457,0.05567164506916571,0.05662079698835659,-0.08919838653312585,-0.17798670250369822,-0.11209238003965492,-0.1466550997826002,0.007018308485098445,-0.10731012513235925,0.021934727273862767,-0.10121753799456695,-0.10510755513187613,-0.030206598061796947,-0.011168924055391107,-0.030126250092984475,0.052571018874522424,0.03212922538581887,0.014671218381555681,0.07240152772526763,0.026498883615361773,-0.020516213044187527,-0.050586132885576916,0.09590802618898926,0.006156830200565392,-0.03918089782609299,-0.015063977331077399,-0.003217573803201393,0.01099884495765986,0.07196163388525496,-0.014249263539225062,0.047208596006717854,0.0844953271892373,-0.09838228242034602,-0.01019872684499838,-0.09244203492691976,-0.03247591747523146,0.0768832890184713,-0.03277680156613214,0.06843487313979452,-0.10042865563834684,-0.05977100211811741,-0.05004451276118726,0.055950664651394706,-0.0104916531421162,-0.04375915422510358,-0.048320573774363614,0.04301828926145297,-0.02431043019878678,0.05407583057270168,-0.03825069118557618,0.019645651439367914,0.0062387815273058774,-0.14015712357228327,-0.08445155852874232,0.02614791311446544,0.033462952748320854,-0.002191920482728132,-0.0013804078918790584,-0.011207019163841836,-0.05140871952135401,-0.11119688358210059,-0.019866480800268663,-0.08520670000827962,0.00499190958035233,0.05033865460622941,0.06669699945161849,-0.07310758983705226,-0.016298194502998423,-0.06426222085036046,-0.04733130834923211,0.015791909029244346,-0.06237524073292359,0.06712336299949904,0.011288398208950712,0.016446245705783024,0.024454425896488878,-0.008854767888281294,-0.04152285217925437,0.0529820494370102,-0.022412268777879808,-0.003776878445792699,0.03789672530959089,0.017808916971501762,0.05518258831153764,-0.09160824748577512,-0.03194455167730118,0.012931652027863004,-0.05089226265516499,0.0044511449526312315,-0.03110592727003196,0.008179542779495601,-0.02070163389236588,0.02504879047454782,-0.037751336021360805,0.10248624365919912,-0.025949684067971105,0.04914010094648406,-0.017648828044269465,-0.005529994365228895,0.06223869927717602,-0.0845866148765882,0.01008627161099801,0.038999881625570824,0.023284192345047586,-0.11225008216651025,-0.15550747473968557,-0.07006916584412039,-0.02661131097776123,-0.021521982117128007,-0.06128430407438024,0.06141429614970686,0.015468442077502613,-0.04410401041158254,-0.03589977137411425,-0.022984187633396054,0.0470971577067185,-0.009721245231268856,0.03339551935147372,0.031000084347597656,0.02452297030846025,-0.039703307014023546,0.08830803603961723]},{`id`:'chunk_5c2a586d6eb5a48bca18b8f2',`document_id`:'summary_dia_test_discordance_001_515497fef089',`title`:'Diabetes in America, Chương 1 - Khác biệt giữa các xét nghiệm glucose - Trang 1-14–1-15',`url`:'https://www.niddk.nih.gov/-/media/Files/Strategic-Plans/Diabetes-in-America-3rd-Edition/DIA_Ch01.pdf',`text`:'Kết quả phân loại đái tháo đường có thể khác nhau tùy dùng A1C, glucose huyết tương lúc đói hay nghiệm pháp dung nạp glucose đường uống. Các phép thử phản ánh những khía cạnh khác nhau của tăng glucose huyết và không phải lúc nào nhận diện cùng một nhóm người. Nghiệm pháp dung nạp glucose đường uống cũng có biến thiên đáng kể khi lặp lại. Vì vậy, không nên coi một phép thử riêng lẻ là tiêu chuẩn tuyệt đối để đối chiếu mọi xét nghiệm khác. Tài liệu nhấn mạnh vai trò của xác nhận kết quả bất thường và đánh giá phù hợp hoàn cảnh lâm sàng.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Diabetes in America, Chương 1 - Khác biệt giữa các xét nghiệm glucose - Trang 1-14–1-15',`source_file`:null,`source_type`:'curated_summary',`source_version`:'515497fef089',`embedding`:[0.12497708504630922,0.08434643080988455,0.49680323740351257,0.386