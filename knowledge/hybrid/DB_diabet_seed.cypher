4318,0.0068766861716687425,0.008756081105849751,0.09330142194855921,-0.04633674516188286,-0.06133702623574001,0.03673724955793272,-0.027861280920833804,0.029237846898735195,0.040536542241413134,-0.0388080034134493,0.035828928459793054,0.028249237375880795,-0.0255258963835328,0.030100685553853413,-0.04000882823463469,-0.08143049819783699]},{`id`:'chunk_7c1bd64712910dd9268f5598',`document_id`:'niddk_a1c_web_95827989eacf',`title`:'The A1C Test & Diabetes',`url`:'https://www.niddk.nih.gov/health-information/diagnostic-tests/a1c-test',`text`:'People with differing test results may be in an early stage of the disease, when blood glucose levels have not risen high enough to show up on every test. In this case, health care professionals may choose to follow the person closely and repeat the test in several months.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Can the A1C test result in a different diagnosis than the blood glucose tests?',`source_file`:null,`source_type`:'web',`source_version`:'95827989eacf',`embedding`:[0.5657878539406801,-0.20862641435430773,-0.0014791620506500842,-0.10099211581990702,0.1101351248927258,-0.03586901911586757,0.006236546801845041,-0.14916615658414756,0.013508072421145706,-0.0709305519904472,0.059697610515562036,0.02877222782829881,-0.05808379646968357,-0.03529827777473902,0.012317417561984857,-0.04753460560635513,-0.07947824894430287,-0.06503481650623111,0.07365731233385056,-0.09825268314923233,-0.12044090803429539,0.04605418567631847,-0.0012715564293565146,-0.005150778814090093,0.10248055509179375,-0.06605365284293875,-0.16199847980567553,-0.13921085963646443,0.05813481522968045,0.09269465230213651,-0.0646182734626573,0.08344307015613935,-0.06772366924718387,0.04106820734783775,0.04092132591230242,0.06687168513023302,0.10833751169901021,-0.08434771703422977,-0.04145413037097583,-0.03184702329835686,0.19349245144038524,-0.1533014110221062,-0.13452581461901797,0.04814849387840696,0.05278906185933957,-0.06581740616156183,-0.0596161