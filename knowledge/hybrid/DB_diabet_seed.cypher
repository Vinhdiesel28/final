 without the written prior permission of the International Diabetes Federation. Requests to reproduce or translate this publication should be e-mail at communications@idf.org. © International Diabetes Federation, 2025 ISBN 978-2-930229-97-3 Please cite this report as International Diabetes Federation. IDF Global Clinical Practice Recommendations for Managing Type 2 Diabetes – 2025. https://idf.org/t2d-cpr-2025',`page`:4,`page_start`:4,`page_end`:4,`section`:'PDF page 4',`source_file`:'IDF_Rec_2025.pdf',`source_type`:'pdf',`source_version`:'767fc7e54bc2',`embedding`:[0.4946021587060544,0.008204673160662349,0.004311512475361866,-0.0017243086814138302,0.04893028852613777,0.28433438025764624,0.08996799240265772,-0.0622347927501098,-0.10264296529536475,-0.07196311910687657,0.04593111193347164,-0.034816013522952306,0.024098948894349527,-0.014906073353250587,-0.04600294382876443,-0.10312606900833308,0.17631312083248316,0.20458907247927227,0.10248606411515128,-0.23150067962304485,-0.001616360060283006,0.06419706508082754,0.12599670130671053,0.08748667152880235,0.08578419073239912,0.12229506117455903,0.020477746095373218,0.04356926040851532,-0.08183488376146765,-0.12385547823820434,-0.031505052770960294,-0.07755551637283153,-0.1511978137627354,-0.03843265589905106,0.07978863595886893,0.04734400542920496,-0.026817444807732273,-0.01990480493152942,-0.08132409109134499,0.06456409560854744,0.21042743389628873,0.10976928281265985,0.0001776264847726589,-0.0830578618315344,-0.08580703172967354,-0.025836029009434096,0.03608183164377435,-0.03148061934026065,0.05043865849599532,-0.11234350023230502,-0.059742613993470965,-0.07489668606760559,-0.0048918989154301115,-0.03989025972777518,-0.055131421003465096,0.0162803039463112,-0.012536725110626609,-0.07268606721889755,-0.0875860208313368,0.06981529363061069,-0.10435649167793874,0.06881285975326629,-0.008187774040476966,-0.004522727822960448,0.02750360262501381,0.018593327743248376,-0.008932604760888333,-0.06120676272230837,-0.1891261319