52482,0.08644925719856417,-0.03823952518572516,-0.005515828522727141,0.08915859393964379,-0.08729288564755318,0.013890507134101334,-0.05972617482643969,0.03773378869560174,-0.07660610802357339,0.03139731382688718,0.035900336186363284,0.011508374997826129,-0.08701967425607296,0.029585841582319652]},{`id`:'chunk_219dedb3cf99af9d7f910f5e',`document_id`:'summary_cdc_135620_structure_001_fc7c39902082',`title`:'CDC - Prevent Type 2 Diabetes - Cấu trúc chương trình phòng ngừa CDC - Trang 1',`url`:'https://stacks.cdc.gov/view/cdc/135620/cdc_135620_DS1.pdf',`text`:'Chương trình thay đổi lối sống thuộc National Diabetes Prevention Program do CDC dẫn dắt được thiết kế nhằm hỗ trợ phòng ngừa hoặc trì hoãn đái tháo đường type 2. Theo infographic, chương trình sử dụng người hướng dẫn lối sống đã được đào tạo, giáo trình được CDC phê duyệt, hỗ trợ theo nhóm và các buổi sinh hoạt trực tiếp hoặc trực tuyến trong một năm. Nội dung hướng tới lựa chọn thực phẩm lành mạnh, vận động hằng ngày, quản lý căng thẳng và giải quyết rào cản thay đổi thói quen. Điều kiện được mô tả gồm người trưởng thành thừa cân có tiền đái tháo đường hoặc tiền sử bệnh thai kỳ.',`page`:null,`page_start`:null,`page_end`:null,`section`:'CDC - Prevent Type 2 Diabetes - Cấu trúc chương trình phòng ngừa CDC - Trang 1',`source_file`:null,`source_type`:'curated_summary',`source_version`:'fc7c39902082',`embedding`:[0.2278436535616867,0.17282158220997101,0.37976536237804703,0.2707233290522422,0.47251614111475576,-0.04845282111434195,0.2792998253270254,-0.037953386008010896,-0.023935701152517627,-0.06974763569758433,-0.10913123558985346,0.01051768418112113,0.04073041680086334,0.0005164914031415031,-0.043116067422121346,-0.13934779305678985,0.111372919188815,-0.0015779189878424606,-0.023754752910820267,0.13974342131455741,-0.0659374690557567,0.0016588055519852647,-0.01013857160363976,0.06634274001627352,0.014129607403505743,-0.13695591241292815,0.004714170698590945,-0.052167551714129394,0.053797515833235575,0.006136129634829578,0.017815289378293003,-0.041284953640292686,-0.08617698012330272,0.09027472894133244,0.026696510785736035,0.09641412834511387,0.01790743108945813,0.010278931542214554,0.07643300215902073,-0.05119837699662356,-0.10714616662168992,0.07801760540189533,-0.0034061548592109795,-0.0355492211346033,0.01686363818106132,0.05154725640827334,0.01471807037411399,-0.07951107617806193,-0.03775331293512455,0.047131008306643504,0.062176811407086204,-0.0548686968993684,-0.10269469192098607,0.06787073487773383,0.034090254334047373,0.041636884575788714,0.010794177681736612,0.012592704922604224,-0.023009531806211857,-0.04913663917735494,-0.004787629892679238,0.03376740518752093,-0.07302383660858351,-0.05990217172286974,0.008288413818721972,-0.029857398341109523,0.06414082271355269,0.032831577222190364,0.0912453773971011,0.06899389425750745,0.011245458165012986,-0.013175227685425187,0.02481535655544077,-0.04886273070427914,0.0787592130080869,0.07591964667607781,-0.05173588540773166,-0.11968281433613273,0.07164214634935294,0.0012272621687005542,0.02484283384598076,-0.08809327700901147,-0.015531754714495126,0.048842643133355707,-0.06794349134384693,-0.018522710447978624,0.006717115804006446,0.009802224253246896,-0.002392697813532887,-0.03660274317927485,-0.01911505808705654,0.053186541291463836,0.0017898483859026823,0.033213468645657225,-0.009165553436654808,0.0026785965656527565,-0.045319223297479366,-0.037496618410596705,-0.05733399392338488,-0.00787136483322892,0.01664264663879729,0.007961391264169762,-0.046422439663125564,-0.018807695166574087,0.041755673898329564,0.08065457254128762,0.04782459603649602,-0.04746586806098176,0.06334352158218026,-0.03398341949108634,0.06984993940463259,0.05318015300891432,-0.019814974608637247,0.001102239185723618,0.15781508069900102,-0.06856122454168065,-0.001159295003948744,0.05447978706162838,-0.12765349065121456,-0.02636504129353917,-0.04213099107157997,0.05375388197027527,-0.06620034621614204,0.0616857971409637,-0.009015953982851764,0.0018781950664570827,-0.07496449261977467,0.015605167315348117]},{`id`:'chunk_11ff335a319c21124d2907fa',`document_id`:'summary_idf2025_ifg_who_ada_001_af001f30d53f',`title`:'IDF 2025 - Khác biệt ngưỡng glucose lúc đói WHO và ADA - Trang 19, 23',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF năm 2025 trình bày hai ngưỡng xác định rối loạn glucose huyết lúc đói (IFG) trong nhóm tiền đái tháo đường. Theo WHO, glucose huyết tương lúc đói từ 110 đến 125 mg/dL, tương đương 6,1–6,9 mmol/L, thuộc khoảng IFG. Theo ADA, khoảng IFG rộng hơn, từ 100 đến 125 mg/dL, tương đương 5,6–6,9 mmol/L. Hai tổ chức cùng sử dụng ngưỡng glucose lúc đói từ 126 mg/dL để xác định đái tháo đường. Vì vậy, cùng một kết quả xét nghiệm có thể được phân loại khác nhau về tiền đái tháo đường tùy bộ tiêu chí áp dụng.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Khác biệt ngưỡng glucose lúc đói WHO và ADA - Trang 19, 23',`source_file`:null,`source_type`:'curated_summary',`source_version`:'af001f30d53f',`embedding`:[0.15465332354173425,-0.041402999078322414,0.4943896268799171,0.32275574803400614,0.39302436606108404,-0.060884299536716084,-0.058158825841941396,0.22715930719802566,-0.03849293465449092,-0.013907837173328741,0.2755219086452155,0.10210050331147376,-0.07023500676927869,-0.07589521621742158,-0.01001122079964977,0.07495226881759473,0.09358384956863933,0.034894154984522335,0.012436499874778063,0.04804986534835389,0.045440927364332646,0.06372230144303666,-0.18386103803572942,-0.010583776712013951,-0.011605564867442865,-0.06056446150347316,-0.023818015240474638,-0.07675839953268192,-0.008016162431437079,0.046826322122719394,-0.0056156874635812475,-0.12506804985439002,-0.035332286893551564,-0.08769940731406672,-0.006060655201957831,-0.04052665818148002,0.07149202092909683,0.06750208933609603,0.005567562785006548,0.03664634437348366,-0.0015159842717703724,-0.017194801998995632,0.02233204925855309,0.044231866646614576,0.07836335290671645,-0.02101416744885621,0.00275051646436439,0.018134538231912512,0.08836877719698107,0.0266688536479384,0.03991044839831004,0.02225516540102144,-0.01813500419919381,-0.13631497701598588,0.03933895599245803,-0.04384806878223682,0.023982853232632502,0.03136527700801728,-0.0858609838701986,-0.06015901532549283,0.06499117667251615,0.0510504463346673,-0.03471786704074481,0.03398126617894319,0.035028604216999576,0.011971009012518689,-0.011505591623494661,0.0216550695645455,-0.12359935518646525,0.07189842599465744,0.06241229308823132,-0.12301543743856608,-0.021279791574630638,0.03819679631927395,-0.07018775636545797,-0.1057617156566477,-0.016582672461572922,-0.06979958313921598,-0.005506516955371103,-0.009465856613757921,-0.03577914001942173,0.08049332135836867,-0.024204309241688534,0.014395866043093874,0.02907541964956911,0.06570746672434281,-0.03751900098070713,-0.012691660825997077,-0.008181970923903588,0.08866272744928311,0.010951384124625037,0.04031866246071838,0.05483869730144482,-0.008939714301015665,0.059342784027072486,0.04866344762288619,0.10046035919495043,0.020958563150878642,0.013274321134447445,-0.023906983371056418,0.023093991867956982,0.041777721101509596,0.014963034090935625,-0.025756761683614807,-0.06073833800503088,0.04365844184790906,-0.0340321403343619,0.04530897453096317,0.0084114772876639,0.024358284378857467,0.012840993089675026,0.04025075119483275,-0.03212262967793,0.002352160126055427,-0.0408627058838527,-0.03354284310512433,0.01601397486193306,-0.05085910686653181,0.0035568580582625597,-0.030505791586831234,0.014337334472904674,-0.051201081468930314,-0.003396904844847525,0.031561084102677356,0.020242487319933593,-0.02219761422932147,-0.01779039054253058,-0.06644056859792638]},{`id`:'chunk_14308f7431cfd8ea0509642b',`document_id`:'summary_idf2025_ifg_igt_mechanism_001_ff6f7da9c3df',`title`:'IDF 2025 - Khác biệt cơ chế IFG và IGT - Trang 23',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'Theo IDF 2025, tiền đái tháo đường bao gồm rối loạn glucose huyết lúc đói (IFG), rối loạn dung nạp glucose (IGT) và nhóm có HbA1c trung gian. IFG và IGT không hoàn toàn giống nhau về cơ chế. IGT liên quan kháng insulin ở cơ, đồng thời khả năng bài tiết insulin bị suy giảm, nên glucose được xử lý kém hiệu quả sau khi uống dung dịch glucose trong nghiệm pháp dung nạp. IFG liên quan suy giảm bài tiết insulin và giảm khả năng ức chế quá trình tạo glucose của gan. Đây là các dấu hiệu nguy cơ tiến triển thành type 2, không phải bằng chứng chắc chắn một người sẽ mắc bệnh.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Khác biệt cơ chế IFG và IGT - Trang 23',`source_file`:null,`source_type`:'curated_summary',`source_version`:'ff6f7da9c3df',`embedding`:[0.18593447602000515,0.0659216704873442,0.48269166299209537,0.4614242416820862,0.5009720650337298,0.0006265787420371323,-0.04313168939479042,-0.009114715002078317,0.09623215454248144,0.034905486639293194,0.018962235516630975,0.05385078530602675,0.15249064535598572,0.05212266561647451,0.054590052611727044,-0.032371219660887685,-0.05295541368496414,-0.024595190731671636,-0.01745241172107802,-0.016852994405058695,0.0678714138668856,0.013302777102593052,0.043700911093728805,-0.07096543176504534,0.11082719246080616,0.009275299077804767,0.03622212748928573,-0.03136466375886308,0.055428010120229076,0.0548707666711943,0.006838786798857692,0.011344491466112954,-0.012959750190887454,-0.013701828356986124,-0.012464011095495192,-0.04607968482931765,0.08525332228731954,0.004398588101665258,-0.08385339245825232,-0.006302097263181696,-0.029857376398705903,-0.022651230044189858,-0.0073938093719320445,-0.042580158288290156,-0.028182975768354462,-0.07243676130319418,-0.009055735188530891,0.01707281545455645,0.012611311387352582,0.009274284150921219,-0.044182210674589814,0.03202006421645813,-0.03472316296803796,-0.048294053517972606,0.006876715107734639,-0.0025421874294614543,0.007975760905565475,0.026144436873998363,-0.06196026300454414,0.009780839654270027,0.09314721928584158,-0.01855685810889675,-0.04069437542887088,0.07819749589558746,0.011494243698911385,0.03205141441017443,-0.0494653468486653,0.09868538255011722,-0.013822842086380377,0.011883779503748984,0.05228635151796463,0.03405223887397646,-0.036812228665344886,0.01602003972469018,-0.04377769963163964,-0.09060470550672818,-0.004513543177210709,0.07582607934005199,0.04870902756782217,-0.006421676058357779,-0.0028488843726745647,-0.016224147702204077,0.05535266831399719,-0.0826616355833834,-0.026981038559924304,-0.03420764269093584,0.02825500957538041,0.012027266366707713,-0.00810238743026658,-0.008855377305585763,-0.04114667906127248,0.011690345498260113,0.06551379902881312,-0.06569479814672112,0.010274311734531602,-0.03042293640532375,0.008975722381106417,0.04948929001038339,-0.06274213217675417,0.015685283188936836,0.004155752190858852,-0.03757106182183283,-0.06346608366844145,0.03887325197333008,0.02033766546102263,0.01023807224703543,0.03653632777663121,-0.002549594121603265,-0.018561081194717406,0.07126758756531261,0.07471285502431253,-0.031416516384654605,0.0025556599724793363,-0.0041819440527858,-0.09232867566268792,-0.059874396552112075,0.03280120815895336,0.05180123921194594,-0.05667177433057197,0.07873861314059895,-0.02105561217988792,-0.024362688145998873,-0.02191952709338576,0.08428012337446067,0.023509990244268773,-0.052739411224997035,-0.0006983126358810446,0.0011994855845050478]},{`id`:'chunk_9bbdfda48258cf3fa98ba2c6',`document_id`:'summary_idf2025_prediabetes_outcomes_001_088b1d8b005a',`title`:'IDF 2025 - Nguy cơ kết cục bất lợi ở tiền đái tháo đường - Trang 24',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'Bản khuyến nghị IDF 2025 tổng hợp các phân tích hệ thống về người có tăng glucose trung gian, còn gọi là tiền đái tháo đường. So với nhóm glucose bình thường, tình trạng này có mối liên quan thống kê với nguy cơ cao hơn của bệnh tim mạch, đột quỵ, bệnh thận mạn và tử vong. Định nghĩa tiền đái tháo đường giữa các nghiên cứu khác nhau. IDF không nói rằng tiền đái tháo đường trực tiếp gây tất cả các bệnh trên ở từng cá nhân. Vì vậy cần diễn giải các kết quả như mối liên quan và nguy cơ, không như kết luận chẩn đoán.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Nguy cơ kết cục bất lợi ở tiền đái tháo đường - Trang 24',`source_file`:null,`source_type`:'curated_summary',`source_version`:'088b1d8b005a',`embedding`:[0.12236451047000199,0.12039597245183722,0.4985039213186307,0.4638321104256483,0.6320262465636066,-0.013571232011926703,0.08065621556614277,0.0023077740569752885,-0.07671362613625,-0.056616566777284674,-0.02835362323101068,-0.01675776459423145,-0.030541861407442583,-0.04648801384663189,-0.04843319918632189,-0.002743561999534164,-0.014416881745536424,-0.0313748648827312,0.05895844639376586,-0.04485366612951553,-7.581017593216694e-05,0.03393593142737738,-0.061898433928441424,-0.033385292160966876,0.028758881999082758,0.025555166786683348,0.0497268504770773,0.010854734667487029,-0.0003271462149106118,0.0008402411272499485,-0.02129045700996448,0.029921185339764494,-0.0037703697863960854,0.040381598673277064,-0.0255458816990448,0.03522217672004213,-0.009412100747553227,0.0036745994638850915,-0.0012486229212156693,0.02582804304389806,0.059359539530804854,-0.013460715910221617,-0.0026136774123547944,0.00020773770135377827,0.012999229954082507,0.02363602009779974,0.007625187632599418,0.04607897849050003,0.01719049309819092,-0.013688198965719147,-0.01284993141913969,-0.017551536294418097,-0.031172727910878682,-0.050428940237470625,-0.07007701412110133,-0.029500829629230004,-0.008281565405113411,-0.028613957484637333,0.05077219578817194,0.038807600829818246,-0.008231900405492636,0.0034756500608297686,0.028788650893996175,0.0010572661233514398,0.007900343008081545,0.01587038817202376,-0.013251644228304129,-0.0020479210349298484,0.025367526398097837,-0.0006465115250030551,-0.021287506186206052,-0.027019478727060613,0.023539287980947433,0.010993256553973867,-0.043644506336266146,-0.008124555998513241,0.028520993961944893,0.04632600078949759,-0.013521292112095712,0.004948496729252964,0.04206035488130604,0.0014759797363639003,0.0018866264731386495,-0.018921618879649136,0.011720569515232782,-0.009362320353023465,0.007553965405655012,0.03499605791701772,0.021665637911708724,0.00859550805545299,0.017747852374577437,0.0009200272465902328,-0.0100299667759396,-0.008691396381196998,-0.0230101176698252,-0.015581200645464505,0.022480429030513602,-0.011764089828637409,-0.0359133950418768,0.0028834130060079507,0.006100734752521393,-0.029071552937664388,-0.044273277928716735,0.03602441965774654,-0.011764151981491958,-0.035424505723856664,0.0029041513861393082,-0.009999270769511587,-0.03559897977234579,-0.04048735095708073,0.03587266912901143,0.04502779001825273,0.03362393089370863,-0.008807760876998789,0.0049836400482356855,0.02981805247816935,-0.02218301601278452,-0.005845799721868881,0.019237092594557036,0.010272020173704842,0.02695927441878289,-0.014388568110790567,-0.018592796117403932,-0.02877653043898197,-0.03211769057090642,-0.03235646694298579,0.04277080795032803,-0.05766650483086861]},{`id`:'chunk_0c296e8b966eb5f818ec5a9b',`document_id`:'summary_idf2025_risk_score_screen_001_a347950cb0f0',`title`:'IDF 2025 - Vai trò của risk score trong sàng lọc - Trang 19, 25',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 xem bảng điểm nguy cơ (risk score) là công cụ hỗ trợ sàng lọc đái tháo đường type 2 chưa được phát hiện và tình trạng tiền đái tháo đường. Điểm nguy cơ tổng hợp thông tin tuổi, tiền sử gia đình, thừa cân và tiền sử đái tháo đường thai kỳ. Thông thường, người được xác định có nguy cơ sẽ tiếp tục được đánh giá bằng xét nghiệm glucose huyết tương hoặc HbA1c. IDF nhấn mạnh việc phát triển hay điều chỉnh bảng điểm theo đặc điểm và dữ liệu địa phương để có khả năng dự đoán phù hợp hơn. Điểm số không thay thế xét nghiệm xác định bệnh.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Vai trò của risk score trong sàng lọc - Trang 19, 25',`source_file`:null,`source_type`:'curated_summary',`source_version`:'a347950cb0f0',`embedding`:[0.15738334666024856,0.12223004335275481,0.4932155517561807,0.4655835170795753,0.6164234055111508,-0.021227099241087472,0.0936969306762795,0.0007182093760723242,-0.07306713142963023,-0.07765866644005955,-0.03294176847033366,-0.06152949466507586,-0.018711973251667582,-0.031137626905460486,-0.029283739321895638,0.030034971778492296,-0.002167580879384836,-0.04774485687825509,-0.017969381513455215,0.0007363374090064519,-0.01922778581874434,0.02967491017968524,0.006028645967013527,0.02345521317783995,-0.011251659334607436,0.02910545171639687,0.04633762605739677,-0.0003316077322266457,-0.0008714226208513061,-0.030277000871067942,-0.004526740868088934,0.01921956373482866,0.000625150088171138,0.0058264913287943134,0.009105544566588856,0.011208247819045879,-0.016319695762554258,-0.014780029847012328,-0.029738546340483413,-0.001508828205337804,-0.0010739715779994757,-0.0028297086807573934,0.03989895360351949,0.007293990883717564,0.012041792817833274,-0.012750781094950583,-0.03774390728271214,0.015288620190441315,-0.008768172776653732,-0.017533234113129507,-0.02914885730658312,0.010291316635806309,-0.015240325196941618,-0.013562470840808591,-0.03570808260311082,-0.019399455632861645,-0.013720078021603917,-0.003218160669789998,-0.007305690770852687,0.0013424646442472552,0.004229006902952336,0.006460636391358638,-0.0012276696097861068,0.005939230969099589,-0.0038966524903922346,0.0017987574079328264,0.013140627148592557,0.005321608758792548,0.01591104858516819,0.00398256001259475,-0.011299347918580368,0.014506101000718804,-0.01664610548901595,-0.0192207985206077,-0.04516746101366649,-0.039385060961399605,0.008839026225111903,-0.04449574848548592,0.06553933947484292,0.004785446021505699,0.004228253604118636,0.026896326814811678,-0.034486060393347714,-0.012784583968858143,0.029597117696957085,0.010124551425037438,0.02734225561650375,0.02000713478622571,0.01896188672378251,0.02907034264366879,-0.03611249901153814,-0.013376736425593273,-0.03150616717560827,-0.005548563594896834,-0.014683703254274814,0.0028886977349491124,0.011061460681220657,-0.05364338741129367,0.042908784877178786,-0.04219234655798576,0.04145689597776794,-0.03830629172638325,0.0524179587968575,-0.014742734308433047,-0.06527497683169792,0.019898272213842196,-0.030538703326910457,-0.014196841125845561,-0.026373201177733025,-0.01580898850049081,-0.05255581724248995,-0.006881403902230952,-0.032683446348696986,0.0012213309161817217,-0.007377014083343726,0.08874696747466845,0.01715905495854051,-0.07058907210054408,-0.011015178069281041,-0.05653585962610259,0.0747908629167474,0.02185974899714721,0.010444316712216137,-0.016979973560460705,-0.03732343657788893,0.03263977461974825,0.03927689645985627,-0.062355385975936595]},{`id`:'chunk_565783e1edeab2bd789e72f6',`document_id`:'summary_idf2025_risk_score_tradeoff_001_f66006d08864',`title`:'IDF 2025 - Đánh đổi của chiến lược sàng lọc hai giai đoạn - Trang 29',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 mô tả một phân tích so sánh các cách sàng lọc nguy cơ đái tháo đường. Nếu đánh giá risk score trước, rồi chỉ cho một số người làm xét nghiệm máu, chi phí sàng lọc và phòng ngừa có thể thấp hơn so với chiến lược dùng nghiệm pháp dung nạp glucose đường uống trực tiếp. Tuy nhiên, phân tích đó ước tính cơ hội ngăn ngừa các trường hợp đái tháo đường mới cũng có thể giảm từ 35% đến 75% tùy kịch bản. Một số người bị xếp vào nhóm nguy cơ thấp vẫn có thể tiến triển thành bệnh. Vì thế không được hiểu kết quả risk score thấp là không có nguy cơ.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Đánh đổi của chiến lược sàng lọc hai giai đoạn - Trang 29',`source_file`:null,`source_type`:'curated_summary',`source_version`:'f66006d08864',`embedding`:[0.14671773416961473,0.11305879252081492,0.474007999367546,0.43288619133781203,0.6310844066438085,-0.05245408773815132,0.1109769938