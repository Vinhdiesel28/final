3793835001487,-0.01948233281291996,0.06847258872893655,-0.025048629986524087,0.02197706807830257,0.012418135475237919,-0.03496676458387124,0.014626520938725041,-0.06860930844822014,0.05688858832864246,0.014268047774695113,0.013711104615946804,-0.019909447282854563,-0.027174382599768,-0.05113517199452977,-0.01313822334739787,-0.04420695214318667,-0.0642822820448803,0.03800613674597493,-0.014155773937325766,-0.045190478234406556,-0.02732256122046518,0.009282825743495439,0.0027345662530424493,0.04227209220982348,0.03302521328074154,0.029226848844283535,-0.013569025108479283,-0.053411330829361496,0.008277921297551685]},{`id`:'chunk_f89b3d8f2df6629b8f5c88c2',`document_id`:'summary_ndep_prediabetes_screen_001_de56996388af',`title`:'Guiding Principles - Tiền đái tháo đường có thể không triệu chứng - Trang 8',`url`:'https://www.niddk.nih.gov/-/media/Files/Health-Information/Health-Professionals/Diabetes/health-care-professionals/Guiding-Principles.pdf',`text`:'Tiền đái tháo đường thường không có triệu chứng rõ, nên nhiều người có thể không biết mình đang có glucose huyết cao hơn bình thường. Tình trạng này liên quan nguy cơ phát triển đái tháo đường type 2 trong tương lai nhưng sự tiến triển không phải điều chắc chắn. Tài liệu NDEP nhấn mạnh việc phát hiện người có nguy cơ qua sàng lọc phù hợp, xét đến tuổi, cân nặng, các yếu tố nguy cơ và kết quả xét nghiệm trước đó. Ở giai đoạn đầu của type 2, nhiều người cũng chưa biểu hiện triệu chứng. Vì vậy, việc không có triệu chứng không đủ để bác bỏ nguy cơ.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Guiding Principles - Tiền đái tháo đường có thể không triệu chứng - Trang 8',`source_file`:null,`source_type`:'curated_summary',`source_version`:'de56996388af',`embedding`:[0.12728353370866222,0.16558623764998576,0.4780193318236805,0.4210507869767362,0.6121042839315841,-0.07970879226430878,0.09542986622679195,-0.058470713165773534,-0.07131716278321873,0.004519920364331736,-0.05679110785137253,-0.02750047499914076,0.02558