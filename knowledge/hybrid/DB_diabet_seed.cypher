02502151866089135,0.07769798257335793,0.020668144111578843,-0.030413637851947756,-0.004042731031042437,-0.027590672133316792,0.004598201571481073,-0.007285524987566414,0.0018445356460635672,-0.02197449449549433,0.018364399884152723,-0.03679603357306507,-0.034915307473289456,-0.011172505978554067,-0.0008271486395287144,0.03709909622512046,-0.0553356754602435,-0.0023449579085411455,-0.0347661253400684,0.04011793711906033,0.0156721541935677,0.047640649187724496,-0.058217724143373666,-0.012722857120391286,0.02409267052606171,-0.012882514805292894,-0.023371509908493883]},{`id`:'chunk_2be92848d608ee5cfbdf4028',`document_id`:'summary_idf2025_ogtt_1h_001_7481a39bd1c3',`title`:'IDF 2025 - Nghiệm pháp OGTT một giờ còn đang được đề xuất - Trang 25',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 đề cập đo glucose huyết tương sau một giờ trong nghiệm pháp dung nạp glucose đường uống 75 g như một lựa chọn đang nổi lên. Dữ liệu dịch tễ học liên hệ glucose sau một giờ từ 155 mg/dL (8,6 mmol/L) với nguy cơ đái tháo đường và biến chứng trong tương lai, ngay cả ở người có dung nạp glucose hai giờ bình thường. Một tuyên bố lập trường IDF đã đề xuất ngưỡng 210 mg/dL (11,6 mmol/L) cho đánh giá type 2. Tuy nhiên, đây là đề xuất chưa phổ biến; còn thiếu thử nghiệm can thiệp riêng cho nhóm có glucose một giờ tăng.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Nghiệm pháp OGTT một giờ còn đang được đề xuất - Trang 25',`source_file`:null,`source_type`:'curated_summary',`source_version`:'7481a39bd1c3',`embedding`:[0.17196281990537587,0.0009111580175547679,0.5090684963839336,0.37533817274620407,0.44306807368205237,-0.04162960693069973,-0.05108507764935791,0.1752349263708762,-0.038466967420361965,-0.021162339810294705,0.22702860951858309,0.07898353261436138,-0.062387575765682865,-0.09632895732793653,-0.019424118049945174,0.09701039124557392,0.13066219542133922,0.03673174932217919,0.01730947737151519,0.05691819793934278,0.01095713449646485,0.10696936362529895,-0.14508932383865883,-0.004882907517781477,-0.021788589690262525,-0.043715792927200084,-0.055740304072429844,-0.040226451605802654,-0.023348213714165143,0.022849406742722452,-0.008704192914798075,-0.09401805860526571,-0.025473960688046377,-0.06206335763454112,0.010489861020897254,0.004792286439552243,0.03762011365941157,0.044597599425171774,0.02067312300400563,0.030628427572039957,0.05640006674937393,-0.006565942674994748,0.016695256092718335,0.047693612352807814,0.04317959353624904,-0.03506096750191605,-0.004719378074614316,0.05438306339797759,0.04614573780298546,0.03450682804754498,0.013389685821825783,-0.00937506954247847,0.0006965834726318145,-0.1425066433563227,0.014059188155426793,-0.06388125930888522,-0.0424197633249443,-0.03555107527530238,0.003026232104501007,-0.014071959535293842,0.04232676319104302,0.018982738324312267,0.06473207531240419,0.06240404065869244,0.047160432719315644,0.042862494968270104,-0.06439286345339294,-0.020129501182307934,-0.06951076116843431,0.05903885985220141,0.029889846633644683,-0.10086089184641785,-0.027928521316819926,0.014524828251803954,-0.036387445784239573,-0.05009511177972558,0.020171604884239046,0.048021727945532576,-0.0878067980390248,-0.026191825426208713,-0.0007038841086009358,0.0431276594459074,0.0045761521002130115,0.026022771941545914,0.02647035510655606,0.06474190393167159,-0.06753339588101169,0.00020766546158315427,0.020799988939304258,0.051091060977555,0.09340309506321308,0.05085010332784465,0.0344240029317206,-0.004025080085124271,0.034279064198719636,0.037879506120291125,0.08341693146455995,0.061541998049887005,-0.011182278726964492,0.010466545363611655,0.025502855882108696,0.06976127322195261,0.023909051149721097,-0.030639616346733674,-0.013183369944510219,-0.005487731032878169,-0.04172374720044575,0.07088271631731842,-0.0008343856563667972,0.05917157964472657,0.020176032592209597,0.020191021028413057,0.015354680478404397,-0.02280380115468542,-0.037305251569204716,-0.012346163081082119,-0.004319842313645139,-0.007382875335825792,0.02328412045419213,-0.03924644673675023,-0.03757521111889266,-0.0572430909987211,-0.0321067182999017,0.04039041357486916,0.03291374189159278,-0.0621060960520846,-0.03990547605941501,-0.002262459627965778]},{`id`:'chunk_e0428e001de8b92a170bc96c',`document_id`:'summary_idf2025_prevention_phenotype_001_074006fbc37f',`title`:'IDF 2025 - Hiệu quả can thiệp lối sống khác nhau giữa IGT và IFG - Trang 20, 23, 26, 28',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 phân biệt bằng chứng phòng ngừa type 2 theo cách nhận diện tiền đái tháo đường. Các nghiên cứu cho thấy thay đổi chế độ ăn kết hợp hoạt động thể lực có hiệu quả ngăn ngừa hoặc trì hoãn type 2 ở người rối loạn dung nạp glucose (IGT), kể cả khi IGT đi kèm IFG. Ngược lại, bằng chứng tổng hợp chưa cho thấy hiệu quả tương tự rõ ràng ở nhóm chỉ có rối loạn glucose huyết lúc đói (IFG đơn độc). Dữ liệu can thiệp trên nhóm chỉ được xác định bằng HbA1c cũng còn hạn chế. Điều đó không phủ nhận giá trị chung của lối sống lành mạnh.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Hiệu quả can thiệp lối sống khác nhau giữa IGT và IFG - Trang 20, 23, 26, 28',`source_file`:null,`source_type`:'curated_summary',`source_version`:'074006fbc37f',`embedding`:[0.17615249241615252,0.0908465646284622,0.5200668424642605,0.43852336454869434,0.5521164953574907,-0.02506364499047821,0.07036575510005554,0.024752909634880315,-0.03459878116021062,-0.05111097093253694,0.0018160626468641148,-0.021591723685625373,0.00644800361042053,-0.053456076179180224,0.0006171154844319413,0.005178252260120428,-0.004410790232497029,-0.07138803844165595,-0.02628981090690159,-0.06561195776088212,-0.004700959823747086,0.052654795708227814,-0.0075155503691570385,0.020763041216373526,0.01545984942194504,0.013333785782511815,0.06280416184499509,-0.04409846543337919,0.0047436696628725475,-0.04229954393134469,-0.015340308968085938,-0.005259688031820427,0.0175583546877096,-0.025076