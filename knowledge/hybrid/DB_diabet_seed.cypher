2162393469244,0.023664890219153783,-0.005926509556181697,0.01835145039561777,-0.052264092739782164,0.02281529257831479,-0.03540244196576675,0.0011841595515094416,-0.011514200435034778,-0.05667652080239336,0.04614920653123779,-0.05791215569790987,0.013365127832318028,0.00486849060644407,0.018401036043137236,0.03348122298561648,0.05990014621551703,0.014194560233231115,0.03913205778463344,-0.023431049606890332,-0.037923852414358146,0.03138389695056684,0.05955155118602788,-0.007805551619227637,-0.033265260649772636,0.015116084676860356,0.062260761064720574,-0.05906417031216593,0.012264386777953301,-0.005774825469864527,0.027509797448895736,0.009539360617996933]},{`id`:'chunk_d9854011a2eb184506ccb721',`document_id`:'summary_idf2025_fib4_001_b9e8c703c5c7',`title`:'IDF 2025 - FIB-4 và giới hạn đánh giá xơ hóa gan - Trang 104',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 trình bày chỉ số FIB-4 như một công cụ sàng lọc nguy cơ xơ hóa gan tiến triển ở người có type 2 và nghi ngờ MASLD. Điểm này được tính từ tuổi, men gan AST, ALT và số lượng tiểu cầu. Trong tài liệu, FIB-4 dưới 1,3 thường gợi ý nguy cơ xơ hóa tiến triển thấp; trên 2,67 gắn với nguy cơ cao; khoảng 1,30–2,67 khó phân loại hơn. IDF lưu ý giới hạn ở người dưới 35 tuổi, ngưỡng riêng với người trên 65 tuổi và độ chính xác thấp hơn ở người đái tháo đường. Do đó FIB-4 không tự xác nhận xơ hóa.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - FIB-4 và giới hạn đánh giá xơ hóa gan - Trang 104',`source_file`:null,`source_type`:'curated_summary',`source_version`:'b9e8c703c5c7',`embedding`:[0.12216925102077246,0.15513870449362588,0.4023294982644942,0.43942852302910745,0.5700244474563889,0.012487162557111731,0.1575356741278068,-0.04137607566949996,-0.14160968254112719,-0.011729862618035937,-0.01218962024711184,-0.08382017227415954,-0.01665321957439042,-0.0469597360338014,-0.00677477240268016,-0.0175198572109674,-0.005830387048969904,0.023183882329844654,0.05574442155666596,0.00398854854239897,0.025935554651860905,-0.005169332725897869,-0.06333070758024627,0.04015185866343225,-0.012364535456190475,0.05611049457172342,0.019715953378670978,0.030871800437745445,-0.04610936858084062,-0.016870168573660187,0.0025052919044969415,-0.008337247645812782,-0.04521076121511814,-0.02134256261084702,-0.0017753496900445975,-0.007327041524356668,-0.05992534683637263,-0.006294295733868084,0.06111905927074187,0.005012245790282711,0.05417780575738248,0.029244218436892833,-0.034069828113755043,0.04652125153965934,-0.08424733978814335,0.06945490137300957,0.0012213543375461167,0.08608219956647589,-0.029556419196099942,-0.0006820467905421561,-0.01342612110058818,0.0013610030450828048,-0.060943176571397875,0.03784608827898272,-0.04586048628359285,-0.010692534097530283,-0.04636011049569194,-0.06885314074672837,0.11790951220462674,0.1147629590310342,-0.013322570739054008,-0.034531033997174006,0.06509937656583083,0.017076185895751758,0.03442171350431682,0.05164648238904172,0.031358575696357464,0.02136600441527144,0.12343061532253921,-0.050764579490975736,-0.08025298470738491,-0.018606511670964027,0.04054357333780083,0.024884204333690377,0.03733573059632579,-0.011204251817337937,-0.056665439499015875,0.08374416147178025,-0.07364241515867907,-0.00689578844596823,0.006194785396303624,-0.0017945281757515165,-0.00904884642099082,-0.00782004543307647,-0.0010557509814011193,-0.01565880646894729,0.033034702838118775,0.025805901365745704,-0.0360304616520308,-0.05987947379385372,0.06511562626525345,0.0015469219797318028,-0.06034634379173502,-0.008552485197174638,0.005388740184772602,0.03052429717286257,-0.02333062751743534,-0.0036102207770483323,0.0565074276767187,-0.014739499484764718,-0.03477932884347486,0.017356777116531708,0.025818780705239023,-0.006697097271736632,-0.03723095114723015,-0.02375578393004295,0.01760785594811777,-0.023781409719095953,-0.0021648784204645988,-0.011329242612541647,-0.07360155896106799,0.048174606160647414,-0.010698770439143272,0.006207062363484822,0.03193320257670657,0.02283858731522772,-0.029751407482032678,-0.03379153965178485,0.0753955509085515,-0.05948781860134449,0.05295057241336178,0.049677955738981615,0.07638584605350503,-0.10504431706927919,-0.016351083456726465,0.057104855092534205,0.02914609088527978,-0.026305019464734722]},{`id`:'chunk_72ec0b783d100bb7a061af1a',`document_id`:'summary_idf2025_masld_imaging_001_65f7e4486e87',`title`:'IDF 2025 - Đánh giá xơ hóa MASLD bằng hình ảnh - Trang 105',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'Trong quy trình đánh giá MASLD ở người type 2, IDF 2025 đề cập sàng lọc hai bước: trước hết dùng điểm FIB-4 để phân tầng nguy cơ xơ hóa gan, sau đó cân nhắc thăm dò hình ảnh khi kết quả cho thấy nguy cơ trung bình hoặc cao. Đo đàn hồi gan thoáng qua (VCTE) ước tính độ cứng gan để hỗ trợ đánh giá xơ hóa, còn cộng hưởng từ đàn hồi (MRE) có thể nhạy hơn ở một số mức độ xơ hóa nhưng cần thiết bị chuyên dụng. Chi phí và khả năng tiếp cận còn hạn chế. Hầu hết trường hợp MASLD không cần sinh thiết gan thường quy.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Đánh giá xơ hóa MASLD bằng hình ảnh - Trang 105',`source_file`:null,`source_type`:'curated_summary',`source_version`:'65f7e4486e87',`embedding`:[0.11876720465578579,0.13534591321531614,0.4119502128814073,0.42912875911222,0.5932217144096319,0.006151964554006647,0.1560320289035265,-0.06214299951030405,-0.14610788350655213,-0.0030695160390722663,-0.042741427217863004,-0.09605816477889968,-0.007218985422734797,-0.03648290945970121,-0.019062032403549017,-0.02556235936144061,-0.008274220703645174,0.01169872163322824,0.05626929184046078,0.013369987438531301,0.03454534616313299,-0.013523289694985122,-0.08705760077511973,0.04240588048009176,0.009460917464629879,0.06180937920030465,0.012592588683840536,0.038014586656206585,-0.030983037208156542,-0.01584807151332058,-0.002443150587817496,-0.011436566114602153,-0.047513485320065746,-0.02533091331694186,-0.0020920542579432344,0.003304305876461638,-0.06662550626178046,0.007715013867834005,0.049315366191070624,-0.006669077653142649,0.03361534478412282,0.032855791215531706,-0.022460655898686583,0.04201965446547412,-0.08986209088580303,0.06094480725822764,0.01140599068298797,0.07011060145213481,-0.03327435064008538,0.012222669488518944,-0.017663116130819834,-0.027332587993678503,-0.06628968794809795,0.044126876450319784,-0.0029125095409282807,-0.015081589168910954,-0.025616652255545793,-0.07440135508479112,0.07946841212791302,0.09529638260875899,0.008822302998295894,-0.05795074683920872,0.06811720927754458,0.025746317434414003,0.057158208341899615,0.03183698740935421,-0.014324550317011155,0.029702961196539358,0.09395301207612049,-0.06946035564640303,-0.06182328504476851,0.012759110229454453,0.01184180318311895,0.008507701570399751,0.029510137021651072,0.0002476406298479123,-0.04227777027778358,0.10651468559015342,-0.08410991574315445,0.004929232585616921,0.004091164210571858,-0.025300222293614536,0.01252966493833851,-0.00920408446550112,-0.01644290738304253,-0.014311265614508923,0.030807754166920574,0.023409952595643952,-0.04349019125107749,-0.049744311998831676,0.03802521481998577,0.016599263024867743,-0.050032988116605615,-0.03576720262793975,-0.005042819702384555,0.03656724791503337,-0.008998401407695528,-0.005914358505859712,0.02624333255947267,-0.00551274684830692,-0.03481650735847374,0.021099180797727674,0.03249027989612395,0.004406468268350372,-0.013125210001110894,-0.009626140125633958,0.015270371914688352,-0.021528521015936858,0.039820579855043864,0.022404014552628682,-0.056909476616615,-0.017412466515470265,-0.01661590864605688,-0.0033291340185187227,0.022413702417515762,-0.05476902237813514,0.023299584306310194,0.020909966708542553,0.045521737770387864,-0.043815229664516675,-0.014028296252816671,0.057964616724023706,0.10043951132061672,-0.08217656137103839,0.03473565619780338,0.06805787491276324,-0.0222205615508604,0.05558611727819608]},{`id`:'chunk_0c06d30f25d9e4662f43dc2b',`document_id`:'summary_idf2025_masld_weight_001_44db59641bc2',`title`:'IDF 2025 - Thay đổi lối sống với nguy cơ gan nhiễm mỡ - Trang 105',`url`:'https://idf.org/media/uploads/2025/05/IDF_Rec_2025.pdf',`text`:'IDF 2025 cho biết ở người type 2 có MASLD đồng thời thừa cân hoặc béo phì, thay đổi lối sống về chế độ ăn và vận động nhằm giảm cân có liên quan cải thiện tình trạng gan nhiễm mỡ. Mức giảm cân duy trì từ 5% được nêu liên quan giảm mỡ trong gan; khoảng 7% đến 10% có thể cải thiện viêm gan; mức từ 10% liên quan cải thiện xơ hóa trong một số nghiên cứu. Tuy vậy, đáp ứng khác nhau và thay đổi mô học chỉ xuất hiện ở thiểu số người trong nghiên cứu can thiệp lối sống. Không được xem đây là kế hoạch điều trị cá nhân tự áp dụng.',`page`:null,`page_start`:null,`page_end`:null,`section`:'IDF 2025 - Thay đổi lối sống với nguy cơ gan nhiễm mỡ - Trang 105',`source_file`:null,`source_type`:'curated_summary',`source_version`:'44db59641bc2',`embedding`:[0.12949841242944857,0.1242142373082786,0.39910632659775575,0.40277764591199555,0.5674923669413175,-0.0024838920247221992,0.14936896881878445,-0.05760443090072976,-0.12928645380291792,-0.014312510522267173,-0.029798123667460173,-0.09534284657818645,0.009969271253167742,-0.03283533973691424,-0.025802594704387314,-0.04737046072276297,0.003104329813144326,0.012155385819051293,0.035724262224730095,0.014830252440932999,0.026897448902418422,-0.002612178826896248,-0.07372848783234691,0.033832175020009674,0.0030457971138176795,0.048153803922037094,0.013700830738579452,0.02991685435947102,-0.030214710647915217,-0.011692796244088227,-0.013868532570535493,-0.020069461932951664,-0.04112794820902623,-0.019071914722266492,-0.0035894933172315323,-7.571453008791235e-05,-0.04257841579878581,-0.00030272870011374974,0.060829783389955025,3.477833049506707e-05,0.008912556897008853,0.027261002633414844,-0.03377121689092362,0.02991536222599637,-0.0972991456630484,0.0698821894761481,0.007089344962856732,0.0522986443462731,-0.04169737972541654,0.019775042