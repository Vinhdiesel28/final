88923263852241,-0.07006131834945097,0.0982717979639571,0.030838166966240126,0.0007433658517624165,-0.05343920295565966,0.001986258643798003,0.07001326813958596,-0.040251726041839506,-0.1775632461491294,0.02740309005211063,-0.08617767245683208,0.08318336844874581,-0.03360642090874199,-0.07388462343368371,0.03546030186829677,0.11154133466391296,-0.13401590684739512,0.15924750367070428,-0.08522065429846867,0.13881407464891538,-0.009677021981223303,0.11651091281597976,0.08891817189070107,-0.025547350491640555,-0.14166248348157312,-0.06600800350196263,0.00812017483245726,0.11762325492764444,-0.018465744513230763,0.004040491037329752,-0.017770447284701573,0.0708351676191673,0.021224963918469678,-0.10419869169734988,0.014914366866376708,0.003663186490868405,0.016385627051437993,-0.0005971217238358762,-0.04298689080433872,-0.05377156999715564,-0.09924790261231534,-0.053224057604956396,0.04201135811139177,-0.023591593046063185,-0.050996463282057404,0.026995599445099286,0.040751175612472386,0.012365904150025633,-0.04682929691434891,-0.0689695966279896,-0.1007815169600311,0.0988869656868828,-0.04903616788560296,-0.04858199461619022,0.010533560683143652,0.012538942421068476,-0.02559821159690122,0.09208823243535119,0.020870475277061675,-0.017245584601893606,-0.03828625843366708,-0.032982040039309296,0.10929334512826532,-0.021421730418058223,-0.003922232876728946,-0.031566231798550656,-0.07677329458397905,0.08188475797781222,-0.01247978534619234,0.004556375118402041,0.007775852358345872]},{`id`:'chunk_e21d7564a22770703db79147',`document_id`:'niddk_a1c_web_95827989eacf',`title`:'The A1C Test & Diabetes',`url`:'https://www.niddk.nih.gov/health-information/diagnostic-tests/a1c-test',`text`:'Health care professionals may use the A1C test early in pregnancy to see if a woman with risk factors had undiagnosed diabetes before becoming pregnant. Since the A1C test reflects your average blood glucose levels over the past 3 months, testing early in pregnancy may include values reflecting time before you were pregnant. The glucose challenge test or the oral glucose tolerance test (OGTT) are used to check for gestational diabetes , usually between 24 and 28 weeks of pregnancy. If you had gestational diabetes, you should be tested for diabetes no later than 12 weeks after your baby is born. If your blood glucose is still high, you may have type 2 diabetes. Even if your blood glucose is normal, you still have a greater chance of developing type 2 diabetes in the future and should get tested every 3 years.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Is the A1C test used during pregnancy?',`source_file`:null,`source_type`:'web',`source_version`:'95827989eacf',`embedding`:[0.6361269254068985,-0.20182047913201556,0.20736519988959579,-0.10456788366774054,0.012437995848726228,-0.05135606971293288,-0.008187061597504276,-0.20962820597692178,0.0376137208513482,-0.006034377588040921,0.06215100322468032,0.11328595240950123,-0.0364395958695249,-0.04086249590414137,0.0078076230869204115,0.034236589592486176,0.01940592567793656,-0.0938495480603974,0.03941796478313987,-0.11045933195301293,-0.08582638521019387,0.01322142831315967,0.05199646165786477,0.024184453803358763,-0.03517941346174217,-0.04202871929638821,-0.1551780610777346,-0.006306286169666516,0.05279082575462195,0.022672130489197796,-0.06853563416383014,0.12798356367951697,-0.09059819675444972,0.020540421432021835,0.037546650790306016,0.11417060310963355,0.01326595423715621,-0.05431128768412938,-0.046991850066989034,-0.10172256128903628,0.05338423612386236,-0.003714733354051087,0.07936150223793613,0.11438471835388087,0.03333312900793989,-0.09533082469389115,-0.05987470734956581,-0.10397999114327157,-0.0335220241664981,-0.026604331470157613,-0.15785378118513965,-0.059453581608277184,0.10478742736228949,-0.04181182016754064,-0.003090864514496161,-0.09233578327745005,0.04071187884401554,-0.04433623833389088,-0.0964321595781078,0.08835683322561638,0.03622796185268788,-0.030949285086981165,0.04045439202524794,0.07554058730795526,0.001838785042484328,-0.06636965291777347,-0.03418596570759705,-0.05039821504167466,0.05271484145314038,0.09988608150915779,-0.000670574040013206,0.0333904910288982,0.019886678606977414,-0.12407627651102827,0.0403399738116572,-0.04105381874596171,-0.028705463563298454,-0.054160767953173566,-0.048459285633116536,0.010604312361250178,0.1200364550806335,-0.08791698284248245,0.05361811956904164,-0.08708791445324626,0.08142264117144099,-0.05243909257672154,0.03962764359171641,-0.03755463868766485,0.031735491595897586,-0.0010041492303796472,-0.006881463856145487,-0.014745660376846444,0.03414534365895651,0.04712684021536362,-0.018135618197732736,-0.08051704060251297,0.04565239841220879,-0.04733435275561629,-0.032881305707884126,-0.015551022062049056,0.07027907545104559,-0.020604146188554086,-0.06502535402100115,0.05725613434024621,-0.021735745170009056,-0.05344834407820841,0.025698871095220153,0.012349165394410933,0.01102315268064509,0.03782342777376439,0.005212351119324027,0.07080609775455125,0.12383263670024164,0.07220018291415742,0.06900836525866255,0.04113919347432869,-0.016292027711512676,-0.011937737276521676,0.0420640855261641,-0.02844565448680647,0.050609877961585045,-0.03253113419527418,0.061982451699804486,-0.008931676817680664,-0.05968032643336305,0.0059623480876049425,-0.044853911642388784,-0.051039801840221485]},{`id`:'chunk_8bda4dece938dae80ad33dd5',`document_id`:'niddk_a1c_web_95827989eacf',`title`:'The A1C Test & Diabetes',`url`:'https://www.niddk.nih.gov/health-information/diagnostic-tests/a1c-test',`text`:'Yes. Health care professionals also use the fasting plasma glucose (FPG) test and the OGTT to diagnose type 2 diabetes and prediabetes. For these blood glucose tests used to diagnose diabetes , you must fast at least 8 hours before you have your blood drawn. If you have symptoms of diabetes, your doctor may use the random plasma glucose test , which doesn’t require fasting. In some cases, health care professionals use the A1C test to help confirm the results of another blood glucose test.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Can other blood glucose tests be used to diagnose type 2 diabetes and prediabetes?',`source_file`:null,`source_type`:'web',`source_version`:'95827989eacf',`embedding`:[0.5232687565308322,-0.14512728694741503,0.2864043080645572,-0.11402116403259953,-0.030153494819325104,0.01880374758037503,-0.09825276906913427,-0.11940907336328156,0.04367333012535098,-0.01365309467986513,0.0626928937766475,0.2290987831723964,-0.17908149145481683,-0.03721441668489452,-0.040785247976832834,0.09844742899397999,-0.0042901260555846445,-0.05064772889347713,0.0322939403400358,-0.02414543312161096,-0.20183875132422283,0.03966990103120053,0.1132593039280046,-0.040134229546723625,0.06088225265903976,-0.10644311679267726,-0.06310272333214308,0.08039752912142438,0.1430152693273023,-0.10099970293733652,-0.18756211058946373,0.12471719396496501,0.0020100703842093064,0.12372564482148377,0.027753182031001185,0.06685653925486157,0.04233979340301699,-0.11769199521887347,-0.07575113861454665,-0.028254549174671025,0.09995280959085338,-0.149534743627739,-0.0458026685968656,0.0733571176540636,-0.014358605799577713,-0.023728288208611312,-0.0003313308632040666,0.061679483983514444,-0.04570147850811978,0.0022199314046084,0.08375459545623762,0.004872248035022472,-0.006773648096191745,0.020690124903507492,-0.05920859116463419,-0.0718633981034526,0.026788895534094873,-0.01303855128434834,0.003706122552841152,-0.002158966931404633,0.0972238577875373,-0.10022664591129786,0.017139030027064656,0.10057163818932034,-0.04026819593319861,0.04732927795170897,-0.06829335575638609,-0.08811055052046467,0.025032455795924436,0.06280681332806347,0.0008463930940275576,0.07079793000960471,0.018546431376713916,-0.06698892202670619,0.027020994969107877,-0.0686917859682182,-0.034980393745294235,0.0026844099816767867,0.11002877023684852,-0.001775433630759423,0.08468275190924546,-0.0014429722633205726,-0.012010414269265282,-0.04612334401098738,0.02431593469076903,-0.02101488443150488,0.08352465740299422,-0.06934731163152456,0.07306449847752244,-0.02909950252206314,0.0001408666588506226,0.018228611218301598,0.0051753957339632515,0.02740471802929514,-0.059066604564130716,0.012851401113220445,0.1496533801494694,-0.015617461935300869,0.0022461935105121513,0.03147567700614974,0.06976121259065428,0.03618114384068881,-0.015460908726751117,0.048603575067048786,-0.010634303635617673,-0.03546291074598632,-0.021108377610683415,-0.05238940990119456,0.026347333477734148,-0.09614054528997994,0.035833106928761245,0.0545662106079413,0.024431408318199163,0.02580268974776894,0.08169387051985096,-0.04073948510421542,-0.04542626217068823,0.08319060605705308,-0.001724113780577591,0.03093150449296765,-0.04218738235609516,-0.029277502851598688,-0.01471026938544017,0.0014575036515004434,-0.03809894656105772,0.036073349643740774,-0.04357154654086314,-0.12892477656081053]},{`id`:'chunk_74e6a58922e161056e00aeca',`document_id`:'niddk_a1c_web_95827989eacf',`title`:'The A1C Test & Diabetes',`url`:'https://www.niddk.nih.gov/health-information/diagnostic-tests/a1c-test',`text`:'Yes. In some people, a blood glucose test may show diabetes when an A1C test does not. The reverse can also occur—an A1C test may indicate diabetes even though a blood glucose test does not. Because of these differences in test results, health care professionals repeat tests before making a diagnosis.',`page`:null,`page_start`:null,`page_end`:null,`section`:'Can the A1C test result in a different diagnosis than the blood glucose tests?',`source_file`:null,`source_type`:'web',`source_version`:'95827989eacf',`embedding`:[0.5240667013401726,-0.1651239049924139,0.17273595489210114,-0.11410456805763834,0.03853686033750769,0.02733153656632396,-0.06999739808616562,-0.17105811823416936,0.024915364301529873,-0.05384331722697227,-0.011795492280792758,0.03443926209670811,-0.14125929202787155,0.06512560065017006,-0.07725348521389346,-0.012390