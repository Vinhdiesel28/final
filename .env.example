# Copy to .env (ignored by git). Do not commit your API key.
LLM_PROVIDER=compatible
# Ollama: LLM_PROVIDER=ollama, LLM_BASE_URL=http://127.0.0.1:11434
# Compatible API: LLM_PROVIDER=compatible, LLM_BASE_URL=https://your-provider/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_API_KEY=
LLM_RESPONSE_FORMAT=json_schema
LLM_TIMEOUT=90
LLM_RATE_LIMIT_MAX_WAIT=20
HYBRID_KB=enabled
