# Fill .env.cloud, not this example. Do not send keys/passwords in chat.
# Neo4j Aura: create an instance, save its generated password/credentials file.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Qdrant Cloud: cluster URL and Database API key (not Cloud Management key).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=diaguard
